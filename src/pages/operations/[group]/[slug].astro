---
import OperationLayout from '../../../layouts/OperationLayout.astro';
import { GROUPS } from '../../../content/operations/manifest';
export function getStaticPaths() {
  return GROUPS.flatMap(g =>
    g.entries.map(e => ({ params: { group: g.key, slug: e.slug } })),
  );
}
const { group, slug } = Astro.params;
---
<OperationLayout slug={slug as string} groupKey={group as string} locale="en" />
