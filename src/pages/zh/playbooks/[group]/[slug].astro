---
import PlaybookLayout from '../../../../layouts/PlaybookLayout.astro';
import { GROUPS } from '../../../../content/playbooks/manifest';
export function getStaticPaths() {
  return GROUPS.flatMap(g =>
    g.entries.map(e => ({ params: { group: g.key, slug: e.slug } })),
  );
}
const { group, slug } = Astro.params;
---
<PlaybookLayout slug={slug as string} groupKey={group as string} locale="zh" />
