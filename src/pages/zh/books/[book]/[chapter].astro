---
import BookChapterLayout from '../../../../layouts/BookChapterLayout.astro';
import { BOOKS, bookChapters } from '../../../../content/books/index';
export function getStaticPaths() {
  return BOOKS.flatMap(b => bookChapters(b).filter(c => c.status === 'published').map(c => ({ params: { book: b.slug, chapter: c.slug } })));
}
const { book, chapter } = Astro.params;
---
<BookChapterLayout book={book as string} chapter={chapter as string} locale="zh" />
