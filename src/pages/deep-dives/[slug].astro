---
import DeepDiveLayout from '../../layouts/DeepDiveLayout.astro';
import { ENTRIES } from '../../content/deep-dives/manifest';
export function getStaticPaths() {
  return ENTRIES.map(e => ({ params: { slug: e.slug } }));
}
const { slug } = Astro.params;
---
<DeepDiveLayout slug={slug as string} locale="en" />
