---
import GroupIndexView from '../../../components/pages/GroupIndexView.astro';
import { GROUPS } from '../../../content/playbooks/manifest';
export function getStaticPaths() {
  return GROUPS.map(g => ({ params: { group: g.key } }));
}
const { group } = Astro.params;
---
<GroupIndexView locale="en" sectionBase="/playbooks" sectionKind="playbook" groupKey={group as string} />
