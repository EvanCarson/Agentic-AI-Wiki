---
// Shared post-preview card. Used by BlogsView (index) and BlogTagView (tag listing).
// Layout: date · reading time · h2 title · summary · tag pills.
//
// Markup pattern: stretched-link. The outer <article> is a positioning context;
// a single <a> spans the whole card via position:absolute;inset:0 to provide the
// card-level navigation. Tag pills sit on top of the stretched link with
// position:relative;z-index:1 so their own clicks reach their own <a> targets.
// This avoids the HTML5 nested-<a> rule, which browsers' tree-construction
// algorithm would otherwise resolve by closing the outer <a> at the first
// inner <a> — severing the tag region from the card link.
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import type { BlogPost } from '../content/blogs/manifest';

export interface Props { post: BlogPost; locale: Locale }
const { post, locale } = Astro.props;
const t = ui[locale];

const title = post.title[locale];
const summary = post.summary[locale];
const href = localizeHref(`/blogs/${post.slug}`, locale);

// Format date as YYYY-MM-DD in both locales — stable, sortable, and locale-neutral.
const dateText = post.date;

// Reading time: use override, else omitted. (A value of 0 is treated as absent.)
const readingTime = post.readingTimeMin;
---
<article class="blog-card">
  {/* Stretched link covering the whole card for keyboard/pointer navigation. */}
  <a class="blog-card-link" href={href} aria-label={title} style="position:absolute;inset:0;border-radius:6px;text-decoration:none;"></a>
  <div class="blog-card-meta">
    <time datetime={post.date}>{t.blog.postedOn} {dateText}</time>
    {readingTime ? <span aria-hidden="true">·</span> : null}
    {readingTime ? <span>{readingTime} {t.blog.readingTime}</span> : null}
  </div>
  <h2 class="blog-card-title">{title}</h2>
  <p class="blog-card-summary">{summary}</p>
  <ul class="blog-card-tags">
    {post.tags.map(tag => (
      <li>
        <a
          href={localizeHref(`/blogs/tag/${tag}`, locale)}
          class="blog-tag"
          aria-label={`${t.blog.taggedWith}: ${tag}`}
        >{tag}</a>
      </li>
    ))}
  </ul>
</article>

<style>
  .blog-card {
    position: relative;
    display: block;
    padding: var(--s-4);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    color: var(--ink);
    transition: border-color 0.15s;
  }
  .blog-card:hover {
    border-color: var(--accent);
  }

  /* Stretched link: covers entire card but sits below tag pills. */
  .blog-card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .blog-card-meta {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--s-2);
  }

  .blog-card-title {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 400;
    line-height: var(--lh-lg);
    margin: 0 0 var(--s-1);
    color: var(--ink);
  }

  .blog-card-summary {
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
    margin: 0 0 var(--s-3);
  }

  /* Tag pills — sit above the stretched link via z-index. */
  .blog-card-tags {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }
</style>
