---
import type { Locale } from '../i18n/index';
import { switchLocalePath, localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
const path = Astro.url.pathname;

// The footer used to be one line of text with zero links. On a changelog
// that runs ~49 phone screens this is where a reader who ran out of content
// actually is, and they found a dead end. It is also the only thing that
// links /privacy, which existed in both locales and was orphaned.
const sections = [
  { href: '/field-guide', label: t.nav.fieldGuide },
  { href: '/concepts', label: t.nav.concepts },
  { href: '/deep-dives', label: t.nav.deepDives },
  { href: '/playbooks', label: t.nav.playbooks },
  { href: '/operations', label: t.nav.operations },
];
const project = [
  { href: '/blogs', label: t.nav.blog },
  { href: '/changelog', label: t.nav.changelog },
  { href: '/about', label: t.nav.about },
  { href: '/privacy', label: t.footer.privacy },
];

// A reader who finished a page had nowhere to go but back. The site published
// two posts a day into a build with no feed and no outbound link of any kind,
// so every visit was terminal by construction. RSS is locale-aware — a zh
// reader subscribes to the zh feed — and the two external links are the same
// pair already named on /about, which is the only other place they appeared.
const follow = [
  { href: localizeHref('/rss.xml', locale), label: 'RSS', external: false },
  { href: 'https://github.com/EvanCarson/Agentic-AI-Wiki', label: 'GitHub', external: true },
  { href: 'https://www.linkedin.com/in/cqian06/', label: 'LinkedIn', external: true },
];
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="wrap">
    <nav class="site-footer-nav" aria-label={t.footer.nav}>
      <div class="site-footer-col">
        <h2 class="site-footer-head">{t.footer.sections}</h2>
        <ul>
          {sections.map(l => <li><a href={localizeHref(l.href, locale)}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="site-footer-col">
        <h2 class="site-footer-head">{t.footer.project}</h2>
        <ul>
          {project.map(l => <li><a href={localizeHref(l.href, locale)}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="site-footer-col">
        <h2 class="site-footer-head">{t.footer.follow}</h2>
        <ul>
          {follow.map(l => (
            <li>
              <a
                href={l.href}
                rel={l.external ? 'noopener' : undefined}
                target={l.external ? '_blank' : undefined}
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="site-footer-col">
        <h2 class="site-footer-head">{t.footer.language}</h2>
        <ul>
          <li><a href={switchLocalePath(path, 'en')} aria-current={locale === 'en' ? 'true' : undefined}>{t.switcher.en}</a></li>
          <li><a href={switchLocalePath(path, 'zh')} aria-current={locale === 'zh' ? 'true' : undefined}>{t.switcher.zh}</a></li>
        </ul>
      </div>
    </nav>
    <p class="site-footer-tagline">{t.tagline} © {year}</p>
  </div>
</footer>
