---
// Sidebar for Concepts / Deep-Dives detail pages. Mirrors ChapterSidebar but
// is driven by a generic grouped-entries list instead of field-guide PARTS.
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
interface SectionEntry { slug: string; title: Record<Locale, string> }
export interface Props {
  locale: Locale;
  base: string;
  ariaLabel: string;
  current: string;
  groups: { group: string | null; items: SectionEntry[] }[];
  /** How to construct an href for an entry. Defaults to `${base}/${entry.slug}`. */
  linkFor?: (e: SectionEntry) => string;
}
const { locale, base, ariaLabel, current, groups, linkFor } = Astro.props;
---
<nav class="chapter-side-nav" aria-label={ariaLabel}>
  {groups.map(g => (
    <div class="side-part-group">
      {g.group && <div class="side-part"><span>{g.group}</span></div>}
      <ul>
        {g.items.map(e => (
          <li>
            <a href={localizeHref(linkFor ? linkFor(e) : `${base}/${e.slug}`, locale)} aria-current={e.slug === current ? 'page' : undefined}>
              {e.title[locale]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
