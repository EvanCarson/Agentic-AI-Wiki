---
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { PARTS } from '../content/field-guide/manifest';
export interface Props { current: string; locale?: Locale }
const { current, locale = 'en' } = Astro.props;
const t = ui[locale];
---
<nav class="chapter-side-nav" aria-label={t.sidebarAria}>
  {PARTS.map(part => (
    <div class="side-part-group">
      <div class="side-part"><span class="roman">{part.roman}</span><span>{part.name[locale]}</span></div>
      <ul>
        {part.chapters.map(ch => (
          <li>
            <a href={localizeHref(`/field-guide/${ch.slug}`, locale)} aria-current={ch.slug === current ? 'page' : undefined}>
              {ch.title[locale]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
