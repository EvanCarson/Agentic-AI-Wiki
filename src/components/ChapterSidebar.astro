---
import { PARTS } from '../content/field-guide/manifest';
export interface Props { current: string }
const { current } = Astro.props;
---
<nav class="chapter-side-nav" aria-label="Field Guide chapters">
  {PARTS.map(part => (
    <div class="side-part-group">
      <div class="side-part"><span class="roman">{part.roman}</span><span>{part.name}</span></div>
      <ul>
        {part.chapters.map(ch => (
          <li>
            <a href={`/field-guide/${ch.slug}`} aria-current={ch.slug === current ? 'page' : undefined}>
              {ch.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
