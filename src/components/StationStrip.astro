---
// The phone's line strip. Below 900px the sidebar's line diagram is not on
// screen, so a reader arriving from search on a phone lost the one thing the
// redesign promises: which line this page is on and where along it. Three
// stations around this one (before, here, after), the line's name, and the
// position as a number. Purely visual; the breadcrumb and prev/next links
// carry the same facts for assistive technology.
import type { Locale } from '../i18n/index';
export interface Props { locale: Locale; lineName: string; index: number; total: number }
const { locale, lineName, index, total } = Astro.props;
const position = locale === 'zh' ? `第 ${index} 站，共 ${total} 站` : `Station ${index} of ${total}`;
const hasPrev = index > 1;
const hasNext = index < total;
---
<div class="station-strip" aria-hidden="true" data-pagefind-ignore>
  <div class="station-strip-track">
    <span class:list={[{ off: !hasPrev }]}></span>
    {hasPrev && <i></i>}
    <span class:list={[{ off: !hasPrev }]}></span>
    <i class="here"></i>
    <span class:list={[{ off: !hasNext }]}></span>
    {hasNext && <i></i>}
    <span class:list={[{ off: !hasNext }]}></span>
  </div>
  <div class="station-strip-label"><b>{lineName}</b><span>{position}</span></div>
</div>
