---
// Left rail for a book chapter: every part and chapter, in reading order.
// Planned chapters are listed (the reader should see the whole shape of the
// book) but not linked — they have no page yet.
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import type { Book } from '../content/books/types';
export interface Props { book: Book; current: string; locale?: Locale }
const { book, current, locale = 'en' } = Astro.props;
const t = ui[locale];
---
<nav class="chapter-side-nav" aria-label={t.books.sidebarAria}>
  <div class="side-part-group">
    <div class="side-part"><a href={localizeHref(`/books/${book.slug}/`, locale)}>{book.title[locale]}</a></div>
  </div>
  {book.parts.map(part => (
    <div class="side-part-group">
      <div class="side-part"><span class="roman">{part.roman}</span><span>{part.name[locale]}</span></div>
      <ul>
        {part.chapters.map(ch => (
          <li>
            {ch.status === 'published'
              ? <a href={localizeHref(`/books/${book.slug}/${ch.slug}/`, locale)} aria-current={ch.slug === current ? 'page' : undefined}>{ch.num && `${ch.num}. `}{ch.title[locale]}</a>
              : <a aria-disabled="true" style="opacity:0.5;pointer-events:none;">{ch.num && `${ch.num}. `}{ch.title[locale]}</a>}
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
