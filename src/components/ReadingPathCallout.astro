---
// "New here?" reading-path callout shown between the hero and the first
// entry group on the /concepts and /deep-dives index pages.
//
// Two variants, both styled by .callout.start in guide.css:
//   - concepts: chip-list of five core slugs (from CORE_PATH_SLUGS) +
//     escape line pointing at the Field Guide
//   - deepDives: one-line redirect to Concepts for newcomers
//
// All copy is bilingual via src/i18n/ui.ts; the slug list is sourced
// from src/content/concepts/manifest.ts.
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { CORE_PATH_SLUGS } from '../content/concepts/manifest';

export interface Props { locale: Locale; mode: 'concepts' | 'deepDives' }
const { locale, mode } = Astro.props;
const conceptsHref = (slug: string) => localizeHref(`/concepts/${slug}`, locale);
const fieldGuideHref = localizeHref('/field-guide', locale);
const conceptsRoot = localizeHref('/concepts', locale);
---
{mode === 'concepts' && (
  <div class="callout start" data-badge={ui[locale].concepts.readingPath.badge} data-pagefind-ignore>
    <p>{ui[locale].concepts.readingPath.intro}</p>
    <div class="path-pills">
      {CORE_PATH_SLUGS.map((slug, i) => (
        <span class="path-step">
          {i > 0 && <span class="path-arrow" aria-hidden="true">→</span>}
          <a class="path-pill" href={conceptsHref(slug)}>{slug}</a>
        </span>
      ))}
    </div>
    <p class="path-escape">
      {ui[locale].concepts.readingPath.escapePrefix}{' '}
      <a href={fieldGuideHref}>{ui[locale].concepts.readingPath.escapeLinkLabel}</a>
    </p>
  </div>
)}
{mode === 'deepDives' && (
  <div class="callout start" data-badge={ui[locale].deepDives.readingPath.badge} data-pagefind-ignore>
    <p class="path-line">
      {ui[locale].deepDives.readingPath.prefix}{' '}
      <a href={conceptsRoot}>{ui[locale].deepDives.readingPath.linkLabel}</a>
    </p>
  </div>
)}
