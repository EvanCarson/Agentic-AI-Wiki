---
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { PARTS, CHAPTERS } from '../content/field-guide/manifest';
export interface Props {
  locale?: Locale;
  /**
   * 'full'  — every chapter listed. The canonical table of contents, and what
   *           /field-guide/ is for.
   * 'parts' — the six parts only, each linking into its first chapter.
   *
   * The homepage used 'full' and it cost 1507px of a 2334px page: 65% of the
   * front door was one flat list of 26 chapter titles with no descriptions —
   * repeated verbatim on /field-guide/, so the site's primary CTA landed on a
   * near-duplicate of the page you just left.
   */
  depth?: 'full' | 'parts';
}
const { locale = 'en', depth = 'full' } = Astro.props;
const t = ui[locale];
const chapterWord = (n: number) => (n > 1 ? t.chapterWord.many : t.chapterWord.one);
---
<nav class="toc">
  <h2>{t.tocHeading}</h2>
  {PARTS.map(part => (
    <div class="toc-part">
      {depth === 'parts' ? (
        <a class="toc-part-link" href={localizeHref(`/field-guide/${part.chapters[0].slug}`, locale)}>
          <span class="toc-part-label">
            <span class="roman">{part.roman}</span>
            <span class="name">{part.name[locale]}</span>
            <span class="meta">{part.chapters.length} {chapterWord(part.chapters.length)}</span>
          </span>
        </a>
      ) : (
        <Fragment>
          <div class="toc-part-label">
            <span class="roman">{part.roman}</span>
            <span class="name">{part.name[locale]}</span>
            <span class="meta">{part.chapters.length} {chapterWord(part.chapters.length)}</span>
          </div>
          {/* series-toc-list, not toc-list: the shared name was split
              2026-07-28 because it also labelled GroupIndexView's numbered
              <ol>, one flat and one decimal — do not re-merge them. */}
          <ul class="series-toc-list" style="list-style:none;padding:0;margin:0;">
            {part.chapters.map(ch => (
              <li style="padding:var(--s-1) 0;border-bottom:1px solid var(--border-soft);">
                <a class="toc-chapter-link" href={localizeHref(`/field-guide/${ch.slug}`, locale)}>
                  <span class="roman" style="font-family:var(--font-body);font-style:italic;color:var(--accent-ink);">{ch.num}</span>
                  <span class="toc-chapter-title" style="font-family:var(--font-display);">{ch.title[locale]}</span>
                </a>
              </li>
            ))}
          </ul>
        </Fragment>
      )}
    </div>
  ))}
  {depth === 'parts' && (
    <a class="toc-see-all" href={localizeHref('/field-guide', locale)}>
      {CHAPTERS.length} {t.home.chapters} · {t.home.seeAllChapters}
    </a>
  )}
</nav>
