---
// The home page's system map: the wiki drawn as a metro network. Each section
// is a line in its own colour, leaving one hub ("you are here"), and each
// line is as long as the section has entries, so the map is also the table of
// contents and its scale. Lengths come from the manifests at build time and
// can never go stale.
//
// Two renderings of the same data. Wide screens get the SVG network; below
// 760px the fan would scale its labels under 10px, so phones get the same
// lines as a list of proportional bars. Only one is ever displayed, so screen
// readers and the keyboard meet each link once.
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { CHAPTERS } from '../content/field-guide/manifest';
import { ENTRIES as CONCEPTS } from '../content/concepts/manifest';
import { ENTRIES as DEEP_DIVES } from '../content/deep-dives/manifest';
import { ENTRIES as PLAYBOOKS } from '../content/playbooks/manifest';
import { ENTRIES as OPERATIONS } from '../content/operations/manifest';
import { POSTS } from '../content/blogs/manifest';
import { BOOKS, bookChapters } from '../content/books/index';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];

const bookChapterCount = BOOKS.reduce((n, b) => n + bookChapters(b).length, 0);
const lines = [
  { key: 'fg', href: '/field-guide', name: t.nav.fieldGuide, size: CHAPTERS.length, count: `${CHAPTERS.length} ${t.home.chapters}` },
  { key: 'bk', href: '/books', name: t.nav.books, size: bookChapterCount, count: `${BOOKS.length} ${t.home.books} · ${bookChapterCount} ${t.home.chapters}` },
  { key: 'co', href: '/concepts', name: t.nav.concepts, size: CONCEPTS.length, count: `${CONCEPTS.length} ${t.home.entries}` },
  { key: 'dd', href: '/deep-dives', name: t.nav.deepDives, size: DEEP_DIVES.length, count: `${DEEP_DIVES.length} ${t.home.entries}` },
  { key: 'pb', href: '/playbooks', name: t.nav.playbooks, size: PLAYBOOKS.length, count: `${PLAYBOOKS.length} ${t.home.entries}` },
  { key: 'op', href: '/operations', name: t.nav.operations, size: OPERATIONS.length, count: `${OPERATIONS.length} ${t.home.entries}` },
  { key: 'bl', href: '/blogs', name: t.nav.blog, size: POSTS.length, count: `${POSTS.length} ${t.home.posts}` },
];
const max = Math.max(...lines.map(l => l.size));

// Geometry, in viewBox units. Lines leave the hub as straight rays to a common
// x, then run horizontally; rays to monotonic y never cross. Track length is
// proportional to size, with a floor so the smallest line still reads as one.
const W = 700, GAP = 68, TOP = 40, HUB_X = 124, FAN_X = 240, MIN_LEN = 36, MAX_LEN = 290;
const H = TOP * 2 + GAP * (lines.length - 1) + 24;
const HUB_Y = TOP + (GAP * (lines.length - 1)) / 2;
const drawn = lines.map((l, i) => {
  const y = TOP + i * GAP;
  const end = FAN_X + Math.max(MIN_LEN, Math.round((l.size / max) * MAX_LEN));
  return { ...l, y, end, d: `M${HUB_X + 14} ${HUB_Y} L${FAN_X} ${y} H${end}` };
});
---
<div class="line-map">
  <svg class="line-map-svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={t.home.mapAria}>
    {drawn.map(l => (
      <a href={localizeHref(l.href, locale)} class="line-map-line" data-line={l.key} aria-label={`${l.name}, ${l.count}`}>
        <path class="line-map-track" d={l.d} />
        <circle class="line-map-stop" cx={l.end} cy={l.y} r="9" />
        <text class="line-map-name" x={l.end + 22} y={l.y - 3}>{l.name}</text>
        <text class="line-map-count" x={l.end + 22} y={l.y + 17}>{l.count}</text>
      </a>
    ))}
    <circle class="line-map-hub" cx={HUB_X} cy={HUB_Y} r="15" />
    <text class="line-map-here" x={HUB_X - 28} y={HUB_Y + 5} text-anchor="end">{t.home.youAreHere}</text>
  </svg>
  <ul class="line-map-list" aria-label={t.home.mapAria}>
    {lines.map(l => (
      <li>
        <a href={localizeHref(l.href, locale)} data-line={l.key}>
          <span class="line-map-list-name">{l.name}</span>
          <span class="line-map-list-count">{l.count}</span>
          <span class="line-map-list-bar" style={`--len:${Math.max(4, Math.round((l.size / max) * 100))}%`} aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</div>
