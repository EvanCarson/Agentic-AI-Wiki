---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTOC from '../SeriesTOC.astro';
import LineMap from '../LineMap.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHAPTERS, PARTS } from '../../content/field-guide/manifest';
import { CHANGELOG } from '../../content/changelog';
import { ENTRIES as CONCEPTS } from '../../content/concepts/manifest';
import { ENTRIES as DEEP_DIVES } from '../../content/deep-dives/manifest';
import { ENTRIES as PLAYBOOKS } from '../../content/playbooks/manifest';
import { ENTRIES as OPERATIONS } from '../../content/operations/manifest';
import { POSTS } from '../../content/blogs/manifest';
import { leadDiagramSvg } from '../../lib/lead-diagram';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const latest = [...CHANGELOG].sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 3);

// Scale and recency, stated. Every section index already prints its own entry
// count ("12 essays", the Concepts jump-chips); the homepage was the one page
// naming no number beyond "6 parts · 26 chapters", so a corpus of 200+ entries
// read as though it might be a dozen. Derived, never hand-typed, so it cannot
// go stale — which is the whole point on a page claiming to be living.
const totalEntries =
  CHAPTERS.length + CONCEPTS.length + DEEP_DIVES.length +
  PLAYBOOKS.length + OPERATIONS.length + POSTS.length;
// Composed here, not inline in the markup: adjacent {expressions} separated
// only by a literal space collapse in the compiled output, which shipped
// "UPDATED2026-07-26" on the first pass.
const statParts = [
  `${totalEntries} ${t.home.entries}`,
  `${PARTS.length} ${t.home.parts}`,
  `${CHAPTERS.length} ${t.home.chapters}`,
];
if (latest[0]) statParts.push(`${t.home.updated} ${latest[0].date}`);
const statLine = statParts.join(' · ');

// The site owns 131 hand-authored, token-themed SVGs and showed none of them
// outside a post body — so every index read as pure text. The newest post's
// lead diagram becomes the homepage's visual anchor.
//
// One diagram at full content width (~828px against a 900-unit viewBox, ~0.92
// scale) stays legible; the same asset shrunk into a card thumbnail does not —
// at 390px a card is ~358px wide, scaling 12px diagram labels to under 5px.
// That is why this is one featured figure rather than a picture on every card.
const featured = POSTS[0] ?? null;
const featuredDiagram = featured ? leadDiagramSvg(featured.slug) : null;
const morePosts = POSTS.slice(1, 4);

---
<BaseLayout title={t.brand} description={t.fg.metaDesc} locale={locale}>
  {/* First viewport: the reader's question (search) on the left, the whole
      network on the right. The map replaces the old Field Guide card and the
      five section cards: same destinations, same counts, one figure. */}
  <section class="home-hero">
    <div class="home-hero-text">
      <h1 set:html={t.home.h1Html} />
      <p class="lede">{t.home.lede}</p>
      <button type="button" class="home-search" data-opens-search>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
        <span>{t.search.open}</span>
      </button>
      <p class="home-stat">{statLine}</p>
    </div>
    <LineMap locale={locale} />
  </section>

  {featured && (
    <section class="wrap home-section home-blog">
      <h2 class="kicker home-grid-heading">{t.home.fromTheBlog}</h2>
      <a class="home-feature" href={localizeHref(`/blogs/${featured.slug}`, locale)}>
        {featuredDiagram && <div class="home-feature-figure" set:html={featuredDiagram} />}
        <div class="home-feature-body">
          <h3 class="home-card-title">{featured.title[locale]}</h3>
          <p class="home-card-tagline">{featured.summary[locale]}</p>
          <p class="home-card-meta">{featured.date} · {t.home.readPost}</p>
        </div>
      </a>
      {morePosts.length > 0 && (
        <ul class="home-latest-list home-blog-more">
          {morePosts.map(p => (
            <li>
              <a href={localizeHref(`/blogs/${p.slug}`, locale)} class="home-changelog-link">
                <span class="home-latest-date">{p.date}</span>{p.title[locale]}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="toc-see-all home-blog-all" href={localizeHref('/blogs', locale)}>{t.home.morePosts}</a>
    </section>
  )}

  <div class="wrap home-toc-wrap"><SeriesTOC locale={locale} depth="parts" /></div>

  {latest.length > 0 && (
    <section class="wrap home-section home-latest">
      <a href={localizeHref('/changelog', locale)} class="home-latest-heading">
        <h2 class="kicker">{t.home.latest}</h2>
      </a>
      <ul class="home-latest-list">
        {latest.map(e => (
          <li>
            <a href={localizeHref('/changelog', locale)} class="home-changelog-link">
              <span class="home-latest-date">{e.date}</span>{e.title[locale]}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {/* The hero's search button opens the same dialog as the header's. */}
  <script is:inline>
    document.querySelectorAll('[data-opens-search]').forEach((b) => {
      b.addEventListener('click', () => document.getElementById('site-search-trigger')?.click());
    });
  </script>
</BaseLayout>
