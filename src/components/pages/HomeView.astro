---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTOC from '../SeriesTOC.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHAPTERS, PARTS } from '../../content/field-guide/manifest';
import { CHANGELOG } from '../../content/changelog';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const latest = [...CHANGELOG].sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 2);
---
<BaseLayout title={t.brand} description={t.fg.metaDesc} locale={locale}>
  <section class="hero wrap">
    <div class="kicker">{t.home.kicker}</div>
    <h1 set:html={t.home.h1Html} />
    <p class="lede">{t.home.lede}</p>
  </section>

  <section class="wrap" style="padding:0 20px 28px;">
    <a href={localizeHref('/field-guide', locale)} style="display:block;border:2px solid var(--ink);background:var(--paper-2);padding:20px;text-decoration:none;color:var(--ink);">
      <div class="kicker">{t.home.featuredKicker}</div>
      <h2 style="font-family:var(--font-display);font-weight:400;font-size:var(--t-xl);line-height:var(--lh-xl);">{t.home.featuredTitle}</h2>
      <p style="font-family:var(--font-mono);font-size:var(--t-2xs);line-height:var(--lh-2xs);letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-top:8px;">
        {PARTS.length} {t.home.parts} · {CHAPTERS.length} {t.home.chapters} · {t.home.startReading}
      </p>
    </a>
  </section>

  <section class="wrap" style="padding:0 20px 28px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
      <a href={localizeHref('/concepts', locale)} style="display:block;border:2px solid var(--ink);background:var(--paper-2);padding:20px;text-decoration:none;color:var(--ink);">
        <div class="kicker">{t.concepts.h1}</div>
        <h2 style="font-family:var(--font-display);font-weight:400;font-size:var(--t-lg);line-height:var(--lh-lg);">{t.concepts.h1}</h2>
        <p style="font-family:var(--font-display);font-size:var(--t-sm);line-height:var(--lh-sm);color:var(--muted);margin-top:8px;">{t.concepts.tagline}</p>
      </a>
      <a href={localizeHref('/deep-dives', locale)} style="display:block;border:2px solid var(--ink);background:var(--paper-2);padding:20px;text-decoration:none;color:var(--ink);">
        <div class="kicker">{t.deepDives.h1}</div>
        <h2 style="font-family:var(--font-display);font-weight:400;font-size:var(--t-lg);line-height:var(--lh-lg);">{t.deepDives.h1}</h2>
        <p style="font-family:var(--font-display);font-size:var(--t-sm);line-height:var(--lh-sm);color:var(--muted);margin-top:8px;">{t.deepDives.tagline}</p>
      </a>
    </div>
  </section>

  <div class="wrap" style="padding:0 20px;"><SeriesTOC locale={locale} /></div>

  {latest.length > 0 && (
    <section class="wrap" style="padding:28px 20px;">
      <a href={localizeHref('/changelog', locale)} style="text-decoration:none;color:inherit;">
        <h2 class="kicker">{t.home.latest}</h2>
      </a>
      <ul style="list-style:none;padding:0;margin:0;">
        {latest.map(e => (
          <li style="padding:8px 0;border-bottom:1px solid var(--border-soft);">
            <a href={localizeHref('/changelog', locale)} style="font-family:var(--font-display);color:var(--ink);text-decoration:none;">
              <span style="font-family:var(--font-mono);font-size:var(--t-2xs);line-height:var(--lh-2xs);color:var(--muted);margin-right:10px;">{e.date}</span>{e.title[locale]}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
