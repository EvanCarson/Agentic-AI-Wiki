---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTOC from '../SeriesTOC.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHAPTERS, PARTS } from '../../content/field-guide/manifest';
import { getCollection } from 'astro:content';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const posts = (await getCollection('posts', p => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout title={t.brand} description={t.fg.metaDesc} locale={locale}>
  <section class="hero wrap">
    <div class="kicker">{t.home.kicker}</div>
    <h1 set:html={t.home.h1Html} />
    <p class="lede">{t.home.lede}</p>
  </section>

  <section class="wrap" style="padding:0 20px 28px;">
    <a href={localizeHref('/field-guide', locale)} style="display:block;border:2px solid var(--ink);background:var(--paper-2);padding:20px;text-decoration:none;color:var(--ink);">
      <div class="kicker">{t.home.featuredKicker}</div>
      <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:26px;">{t.home.featuredTitle}</h2>
      <p style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-top:8px;">
        {PARTS.length} {t.home.parts} · {CHAPTERS.length} {t.home.chapters} · {t.home.startReading}
      </p>
    </a>
  </section>

  <div class="wrap" style="padding:0 20px;"><SeriesTOC locale={locale} /></div>

  {posts.length > 0 && (
    <section class="wrap" style="padding:28px 20px;">
      <h2 class="kicker">{t.home.latest}</h2>
      <ul style="list-style:none;padding:0;margin:0;">
        {posts.map(p => (
          <li style="padding:8px 0;border-bottom:1px solid rgba(0,0,0,0.15);">
            <a href={localizeHref(`/posts/${p.slug}`, locale)} style="font-family:'Fraunces',serif;color:var(--ink);text-decoration:none;">{p.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
