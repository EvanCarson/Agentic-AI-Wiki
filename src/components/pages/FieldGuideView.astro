---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTOC from '../SeriesTOC.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { ogImageFor } from '../../lib/og';
import { parse } from 'node-html-parser';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const bodies = import.meta.glob('../../content/field-guide/*/*.html', { query: '?raw', import: 'default', eager: true });
const introHtml = bodies[`../../content/field-guide/${locale}/intro.html`] as string | undefined;
const heroEl = introHtml ? parse(introHtml).querySelector('.hero') : null;
const hero = heroEl ? heroEl.outerHTML : '';
---
<BaseLayout title={t.fg.metaTitle} description={t.fg.metaDesc} locale={locale} image={ogImageFor('fieldGuide', locale)}>
  <div class="wrap" set:html={hero} />
  <div class="wrap"><SeriesTOC locale={locale} /></div>
</BaseLayout>
