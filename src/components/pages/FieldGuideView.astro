---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesTOC from '../SeriesTOC.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { parse } from 'node-html-parser';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const bodies = import.meta.glob('../../content/field-guide/*/*.html', { query: '?raw', import: 'default', eager: true });
const introHtml = (bodies[`../../content/field-guide/${locale}/intro.html`] ?? bodies[`../../content/field-guide/en/intro.html`]) as string;
const heroEl = parse(introHtml).querySelector('.hero');
const hero = heroEl ? heroEl.outerHTML : '';
---
<BaseLayout title={t.fg.metaTitle} description={t.fg.metaDesc} locale={locale}>
  <div class="wrap" set:html={hero} />
  <div class="wrap"><SeriesTOC locale={locale} /></div>
</BaseLayout>
