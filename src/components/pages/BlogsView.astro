---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../BlogCard.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { POSTS, allTags } from '../../content/blogs/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';

export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const tags = allTags();
---
<BaseLayout title={t.blog.metaTitle} description={t.blog.metaDesc} locale={locale} image={ogImageFor('blog', locale)} pagefindFilter={pagefindFilterFor('blog', locale)}>
  <section class="hero">
    <div class="kicker">{t.blog.h1}</div>
    <h1>{t.blog.h1}</h1>
    <p class="lede">{t.blog.tagline}</p>
  </section>
  <section class="wrap" style="padding:28px 20px;">
    {tags.length > 0 && (
      <nav aria-label={t.blog.allTags} style="margin-bottom:20px;display:flex;flex-wrap:wrap;gap:6px;" data-pagefind-ignore>
        <span style="color:var(--muted);font-size:13px;align-self:center;">{t.blog.allTags}:</span>
        {tags.map(tag => (
          <a href={localizeHref(`/blogs/tag/${tag}`, locale)}
             style="display:inline-block;padding:2px 10px;border:1px solid var(--border-soft);border-radius:999px;font-size:13px;color:var(--muted);text-decoration:none;">{tag}</a>
        ))}
      </nav>
    )}
    <div style="display:grid;gap:14px;">
      {POSTS.map(p => <BlogCard post={p} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
