---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../BlogCard.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { POSTS, allTags } from '../../content/blogs/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';

export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const tags = allTags();
---
<BaseLayout title={t.blog.metaTitle} description={t.blog.metaDesc} locale={locale} image={ogImageFor('blog', locale)} pagefindFilter={pagefindFilterFor('blog', locale)}>
  <section class="hero">
    <div class="kicker">{t.blog.h1}</div>
    <h1>{t.blog.h1}</h1>
    <p class="lede">{t.blog.tagline}</p>
  </section>
  <section class="wrap blog-index-body">
    {/* Was an always-open wall of 44 chips: 375px of an 844px phone screen —
        44% of the first view — before a single post title. Real filtering,
        rendered as chrome. A <details> keeps it one tap away; it defaults
        open from 768px up, where the row is two cheap lines. */}
    {tags.length > 0 && (
      <details class="blog-all-tags-wrap" data-pagefind-ignore>
        <summary class="blog-all-tags-summary">
          {t.blog.allTags} <span class="blog-all-tags-count">{tags.length}</span>
        </summary>
        <nav class="blog-all-tags" aria-label={t.blog.allTags}>
          {tags.map(tag => (
            <a href={localizeHref(`/blogs/tag/${tag}`, locale)} class="blog-tag">{tag}</a>
          ))}
        </nav>
      </details>
    )}
    <div class="blog-list">
      {POSTS.map(p => <BlogCard post={p} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index-body {
    padding: var(--s-5) var(--s-4);
  }
  .blog-all-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    align-items: center;
    margin-bottom: var(--s-5);
  }
  .blog-all-tags-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: var(--s-0);
  }
  .blog-all-tags-wrap { margin-bottom: var(--s-5); }
  .blog-all-tags-summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    cursor: pointer;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease);
  }
  .blog-all-tags-summary:hover { color: var(--ink); }
  .blog-all-tags-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .blog-all-tags-count {
    font-family: var(--font-mono);
    color: var(--accent-ink);
  }
  .blog-all-tags-wrap[open] .blog-all-tags-summary { color: var(--ink); }
</style>

<script is:inline>
  // Open by default from 768px up, where the chip row is two cheap lines;
  // closed below, where it was eating 44% of the first screen. Done in JS
  // rather than CSS because `open` is an attribute, not a style, and a
  // media-query-driven [open] is not expressible in CSS. Runs once at load
  // and is not re-applied on resize, so a reader's own toggle always wins.
  (() => {
    const d = document.querySelector('.blog-all-tags-wrap');
    if (d && window.matchMedia('(min-width: 768px)').matches) d.open = true;
  })();
</script>
