---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../BlogCard.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { POSTS, allTags } from '../../content/blogs/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';

export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const tags = allTags();
---
<BaseLayout title={t.blog.metaTitle} description={t.blog.metaDesc} locale={locale} image={ogImageFor('blog', locale)} pagefindFilter={pagefindFilterFor('blog', locale)}>
  <section class="hero">
    <div class="kicker">{t.blog.h1}</div>
    <h1>{t.blog.h1}</h1>
    <p class="lede">{t.blog.tagline}</p>
  </section>
  <section class="wrap blog-index-body">
    {tags.length > 0 && (
      <nav class="blog-all-tags" aria-label={t.blog.allTags} data-pagefind-ignore>
        <span class="blog-all-tags-label">{t.blog.allTags}:</span>
        {tags.map(tag => (
          <a href={localizeHref(`/blogs/tag/${tag}`, locale)} class="blog-tag">{tag}</a>
        ))}
      </nav>
    )}
    <div class="blog-list">
      {POSTS.map(p => <BlogCard post={p} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index-body {
    padding: 28px 20px;
  }
  .blog-all-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-bottom: 24px;
  }
  .blog-all-tags-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: 2px;
  }
</style>
