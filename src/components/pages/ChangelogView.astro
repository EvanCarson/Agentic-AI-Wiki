---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHANGELOG } from '../../content/changelog';
import { ogImageFor } from '../../lib/og';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const entries = [...CHANGELOG].sort((a, b) => (a.date < b.date ? 1 : -1));
---
<BaseLayout title={t.changelog.metaTitle} description={t.changelog.metaDesc} locale={locale} image={ogImageFor('changelog', locale)}>
  <section class="wrap" style="padding:24px 20px;">
    <div class="kicker">{t.changelog.kicker}</div>
    <h1 style="font-family:'Fraunces',serif;font-weight:400;font-size:32px;margin:.2em 0 .15em;">{t.changelog.h1}</h1>
    <p class="lede" style="margin-bottom:28px;">{t.changelog.intro}</p>

    <ol style="list-style:none;padding:0;margin:0;border-left:2px solid rgba(0,0,0,0.12);">
      {entries.map(e => (
        <li style="position:relative;padding:0 0 30px 22px;">
          <span aria-hidden="true" style="position:absolute;left:-7px;top:6px;width:11px;height:11px;border-radius:50%;background:var(--accent);"></span>
          <time datetime={e.date} class="kicker" style="display:block;">{e.date}</time>
          <h2 style="font-family:'Fraunces',serif;font-weight:400;font-size:21px;margin:.15em 0 .5em;">{e.title[locale]}</h2>
          <ul style="margin:0;padding-left:18px;">
            {e.items.map(it => (
              <li style="margin:.3em 0;color:var(--ink);">{it[locale]}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
