---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHANGELOG } from '../../content/changelog';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
import { renderChangelogItem } from '../../lib/changelog-markup';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const entries = [...CHANGELOG].sort((a, b) => (a.date < b.date ? 1 : -1));

// The page was 40,995px at 390px — 48.6 phone screens — with zero in-page
// anchors, zero filters and no grouping: one unbroken timeline of 61 fully
// expanded entries. Grouping by month gives it a skeleton and a jump bar,
// with no JavaScript and no change to the timeline itself.
const MONTHS: Record<Locale, string[]> = {
  en: ['January', 'February', 'March', 'April', 'May', 'June',
       'July', 'August', 'September', 'October', 'November', 'December'],
  zh: ['1 月', '2 月', '3 月', '4 月', '5 月', '6 月',
       '7 月', '8 月', '9 月', '10 月', '11 月', '12 月'],
};
const monthLabel = (ym: string) => {
  const [y, m] = ym.split('-');
  return locale === 'zh' ? `${y} 年 ${MONTHS.zh[Number(m) - 1]}` : `${MONTHS.en[Number(m) - 1]} ${y}`;
};

const groups: { ym: string; label: string; id: string; entries: typeof entries }[] = [];
for (const e of entries) {
  const ym = e.date.slice(0, 7);
  const last = groups[groups.length - 1];
  if (last && last.ym === ym) last.entries.push(e);
  else groups.push({ ym, label: monthLabel(ym), id: `m-${ym}`, entries: [e] });
}
---
<BaseLayout title={t.changelog.metaTitle} description={t.changelog.metaDesc} locale={locale} image={ogImageFor('changelog', locale)} pagefindFilter={pagefindFilterFor('changelog', locale)}>
  <section class="hero">
    <div class="kicker">{t.changelog.kicker}</div>
    <h1>{t.changelog.h1}</h1>
    <p class="lede">{t.changelog.intro}</p>
  </section>
  <section class="wrap changelog-body">
    <nav class="changelog-jump" aria-label={t.changelog.jumpTo} data-pagefind-ignore>
      <span class="changelog-jump-label">{t.changelog.jumpTo}</span>
      {groups.map(g => (
        <a href={`#${g.id}`} class="changelog-jump-link">
          {g.label} <span class="changelog-jump-count">{g.entries.length}</span>
        </a>
      ))}
    </nav>

    {groups.map(g => (
      <section class="changelog-month" aria-labelledby={g.id}>
        <h2 class="changelog-month-head" id={g.id}>{g.label}</h2>
        <ol class="changelog-list">
          {g.entries.map(e => (
            <li class="changelog-entry">
              <span aria-hidden="true" class="changelog-dot"></span>
              <time datetime={e.date} class="kicker changelog-date">{e.date}</time>
              {/* Collapsed by default, opened at >=900px by the script below.
                  Every entry fully expanded made this 58 phone screens; the
                  bullets are the detail, the title is the scan line. The text
                  stays in the DOM either way, so Pagefind still indexes it. */}
              <details class="changelog-detail">
                <summary class="changelog-title">{e.title[locale]}</summary>
                <ul class="changelog-items">
                  {/* Entries are authored with `code` and *emphasis*; this was
                      a text node, so readers saw the punctuation. Paths that
                      name a page also become links — the page whose job is
                      announcing new pages linked to none of them. Input is
                      escaped before any tag is added; see the lib. */}
                  {e.items.map(it => <li set:html={renderChangelogItem(it[locale], locale)} />)}
                </ul>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>

  <script is:inline>
    // Expand every entry from 900px up, where vertical space is not the
    // constraint. Mirrors the tag wall on /blogs/. Runs once at load and is
    // not re-applied on resize, so a reader's own toggle always wins.
    (() => {
      if (!window.matchMedia('(min-width: 900px)').matches) return;
      for (const d of document.querySelectorAll('.changelog-detail')) d.open = true;
    })();
  </script>
</BaseLayout>
