---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHANGELOG, type LineKey } from '../../content/changelog';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
import { renderChangelogItem } from '../../lib/changelog-markup';
import { linesFor, LINE_ORDER } from '../../lib/changelog-lines';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const entries = [...CHANGELOG]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .map((e) => ({ ...e, lines: linesFor(e) }));

// Line Map changelog (2026-10-27). The page is a timetable of the network:
// a chart of how many changes each month brought, split by the line (site
// section) they touched; filter chips that narrow the list to one line; and
// one-line rows whose bullets open on demand. Grouping by month is kept from
// the 2026-07 pass, which took the page from 48 phone screens to a skeleton.
const MONTHS: Record<Locale, string[]> = {
  en: ['January', 'February', 'March', 'April', 'May', 'June',
       'July', 'August', 'September', 'October', 'November', 'December'],
  zh: ['1 月', '2 月', '3 月', '4 月', '5 月', '6 月',
       '7 月', '8 月', '9 月', '10 月', '11 月', '12 月'],
};
const monthLabel = (ym: string) => {
  const [y, m] = ym.split('-');
  return locale === 'zh' ? `${y} 年 ${MONTHS.zh[Number(m) - 1]}` : `${MONTHS.en[Number(m) - 1]} ${y}`;
};
// Phone labels: "Oct 2026". Chinese is already short.
const monthShort = (ym: string) => {
  const [y, m] = ym.split('-');
  return locale === 'zh' ? monthLabel(ym) : `${MONTHS.en[Number(m) - 1].slice(0, 3)} ${y}`;
};
// Row dates: "Oct 27" / "10 月 27 日".
const dayLabel = (date: string) => {
  const [, m, d] = date.split('-').map(Number);
  return locale === 'zh' ? `${m} 月 ${d} 日` : `${MONTHS.en[m - 1].slice(0, 3)} ${d}`;
};
const count = (n: number) => (n === 1 ? t.changelog.countOne : t.changelog.countMany).replace('{n}', String(n));

const LINE_NAME: Record<LineKey, string> = {
  fg: t.nav.fieldGuide, bk: t.nav.books, co: t.nav.concepts, dd: t.nav.deepDives,
  pb: t.nav.playbooks, op: t.nav.operations, bl: t.nav.blog, hub: t.changelog.site,
};

type Row = (typeof entries)[number];
const groups: { ym: string; label: string; short: string; id: string; entries: Row[]; share: Map<LineKey, number> }[] = [];
for (const e of entries) {
  const ym = e.date.slice(0, 7);
  let g = groups[groups.length - 1];
  if (!g || g.ym !== ym) {
    g = { ym, label: monthLabel(ym), short: monthShort(ym), id: `m-${ym}`, entries: [], share: new Map() };
    groups.push(g);
  }
  g.entries.push(e);
  // Each change counts once, split equally among the lines it touched, so a
  // month's segments add up to exactly its number of changes.
  for (const k of e.lines) g.share.set(k, (g.share.get(k) ?? 0) + 1 / e.lines.length);
}
const maxMonth = Math.max(...groups.map((g) => g.entries.length));
const used = new Set(entries.flatMap((e) => e.lines));
const usedLines = LINE_ORDER.filter((k) => used.has(k));
---
<BaseLayout title={t.changelog.metaTitle} description={t.changelog.metaDesc} locale={locale} image={ogImageFor('changelog', locale)} pagefindFilter={pagefindFilterFor('changelog', locale)}>
  <section class="hero">
    <h1>{t.changelog.h1}</h1>
    <p class="lede">{t.changelog.intro}</p>
  </section>
  <section class="wrap changelog-body" data-count-one={t.changelog.countOne} data-count-many={t.changelog.countMany}>
    <section class="changelog-chart" aria-labelledby="changelog-chart-h" data-pagefind-ignore>
      <h2 class="changelog-chart-title" id="changelog-chart-h">{t.changelog.chartTitle}</h2>
      <ol class="changelog-chart-rows">
        {groups.map((g) => (
          <li>
            <a class="changelog-chart-row" href={`#${g.id}`} aria-label={`${g.label}: ${count(g.entries.length)}`}>
              <span class="changelog-chart-month" aria-hidden="true">
                <span class="changelog-chart-long">{g.label}</span><span class="changelog-chart-short">{g.short}</span>
              </span>
              <span class="changelog-chart-track" aria-hidden="true">
                <span class="changelog-chart-bar" style={`width: ${((g.entries.length / maxMonth) * 100).toFixed(2)}%`}>
                  {LINE_ORDER.filter((k) => g.share.has(k)).map((k) => (
                    <span class="changelog-seg" data-line={k} style={`flex-grow: ${g.share.get(k)!.toFixed(3)}`}></span>
                  ))}
                </span>
              </span>
              <span class="changelog-chart-count" aria-hidden="true">{g.entries.length}</span>
            </a>
          </li>
        ))}
      </ol>
      <ul class="changelog-legend" aria-label={t.changelog.chartLegend}>
        {usedLines.map((k) => (
          <li><span class="changelog-dot" data-line={k} aria-hidden="true"></span>{LINE_NAME[k]}</li>
        ))}
      </ul>
    </section>

    {/* Hidden until the script runs: without JavaScript every entry shows
        and there is nothing for a chip to do. */}
    <div class="changelog-filter" role="group" aria-labelledby="changelog-filter-label" hidden data-pagefind-ignore>
      <span class="changelog-filter-label" id="changelog-filter-label">{t.changelog.show}</span>
      <button type="button" class="changelog-chip" data-filter="all" aria-pressed="true">{t.changelog.all}</button>
      {usedLines.map((k) => (
        <button type="button" class="changelog-chip" data-filter={k} aria-pressed="false">
          <span class="changelog-dot" data-line={k} aria-hidden="true"></span>{LINE_NAME[k]}
        </button>
      ))}
    </div>

    {groups.map((g) => (
      <section class="changelog-month" aria-labelledby={g.id}>
        <h2 class="changelog-month-head" id={g.id}>
          {g.label} <span class="changelog-month-count" data-total={g.entries.length}>{count(g.entries.length)}</span>
        </h2>
        <ol class="changelog-list">
          {g.entries.map((e) => (
            <li class="changelog-entry" data-lines={e.lines.join(' ')}>
              <span class="changelog-meta">
                <time datetime={e.date} class="changelog-date">{dayLabel(e.date)}</time>
                <span class="changelog-dots">
                  {e.lines.map((k) => <span class="changelog-dot" data-line={k} aria-hidden="true"></span>)}
                  <span class="visually-hidden">{t.changelog.sections} {e.lines.map((k) => LINE_NAME[k]).join(locale === 'zh' ? '、' : ', ')}</span>
                </span>
              </span>
              {/* Collapsed at every width: the title is the scan line, the
                  bullets are the detail. The text stays in the DOM either
                  way, so Pagefind still indexes it. */}
              <details class="changelog-detail">
                <summary class="changelog-title">
                  <span class="changelog-title-text">{e.title[locale]}</span>
                  <svg class="changelog-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <ul class="changelog-items">
                  {/* Entries are authored with `code` and *emphasis*; paths
                      that name a page become links. Input is escaped before
                      any tag is added; see the lib. */}
                  {e.items.map((it) => <li set:html={renderChangelogItem(it[locale], locale)} />)}
                </ul>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>

  <script is:inline>
    // Filter chips: narrow the list to one line, hide months left empty,
    // re-count the month headings, and dim the chart segments of other lines.
    (() => {
      const root = document.querySelector('.changelog-body');
      const bar = root && root.querySelector('.changelog-filter');
      if (!bar) return;
      const one = root.dataset.countOne, many = root.dataset.countMany;
      const chips = [...bar.querySelectorAll('.changelog-chip')];
      const apply = (key) => {
        for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.filter === key));
        for (const month of root.querySelectorAll('.changelog-month')) {
          let n = 0;
          for (const li of month.querySelectorAll('.changelog-entry')) {
            const show = key === 'all' || li.dataset.lines.split(' ').includes(key);
            li.hidden = !show;
            if (show) n++;
          }
          month.hidden = n === 0;
          const label = month.querySelector('.changelog-month-count');
          if (label) label.textContent = (n === 1 ? one : many).replace('{n}', String(n));
        }
        for (const seg of root.querySelectorAll('.changelog-seg')) {
          seg.classList.toggle('is-dim', key !== 'all' && seg.dataset.line !== key);
        }
      };
      for (const c of chips) c.addEventListener('click', () => apply(c.dataset.filter));
      bar.hidden = false;
    })();
  </script>
</BaseLayout>
