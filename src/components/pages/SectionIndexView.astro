---
// Shared index renderer for the Concepts and Deep-Dives sections.
// Renders a localized "coming soon" line when the manifest is empty, and a
// grouped/ordered list of entries when populated. Grouping uses the optional
// `group` field; ungrouped entries render as a flat list.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
import type { OgSectionKey } from '../../content/og';

interface SectionEntry {
  slug: string;
  title: Record<Locale, string>;
  summary: Record<Locale, string>;
  group?: Record<Locale, string>;
}
interface SectionStrings { metaTitle: string; metaDesc: string; h1: string; tagline: string; emptyHtml: string }

export interface Props {
  locale: Locale;
  base: string;                       // e.g. '/concepts'
  strings: SectionStrings;            // localized UI strings for this section
  groups: { group: string | null; items: SectionEntry[] }[];
  sectionKey: OgSectionKey;
}
const { locale, base, strings, groups, sectionKey } = Astro.props;
const empty = strings.emptyHtml.replace('%FG%', localizeHref('/field-guide', locale));
const isEmpty = groups.length === 0 || groups.every(g => g.items.length === 0);
---
<BaseLayout title={strings.metaTitle} description={strings.metaDesc} locale={locale} image={ogImageFor(sectionKey, locale)} pagefindFilter={pagefindFilterFor(sectionKey, locale)}>
  <section class="hero">
    <div class="kicker">{strings.h1}</div>
    <h1>{strings.h1}</h1>
    <p class="lede">{strings.tagline}</p>
  </section>
  <section class="wrap" style="padding:28px 20px;">
    {isEmpty
      ? <p class="lede" set:html={empty} />
      : groups.map(g => (
          <div class="toc-part">
            {g.group && <div class="toc-part-label"><span class="name">{g.group}</span><span class="meta">{g.items.length}</span></div>}
            <ul class="toc-list" style="list-style:none;padding:0;margin:0;">
              {g.items.map(e => (
                <li style="padding:14px 0;border-bottom:1px solid rgba(0,0,0,0.15);">
                  <a class="entry-link" href={localizeHref(`${base}/${e.slug}`, locale)} style="text-decoration:none;color:var(--ink);display:block;">
                    <div style="font-family:'Fraunces',serif;font-size:19px;">{e.title[locale]}</div>
                    <div style="color:var(--muted);font-size:14px;line-height:1.45;margin-top:4px;">{e.summary[locale]}</div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
  </section>
</BaseLayout>
<style is:global>
  .entry-link:hover .name-line,
  .entry-link:hover > div:first-child { color: var(--accent-ink); }
  /* Empty-state CTA link is small body text — use the AA-contrast accent
     (overrides the inline color in the i18n emptyHtml string). */
  .lede a { color: var(--accent-ink) !important; }
</style>
