---
// Shared index renderer for the Concepts and Deep-Dives sections.
// Renders a localized "coming soon" line when the manifest is empty, and a
// grouped/ordered list of entries when populated. Grouping uses the optional
// `group` field; ungrouped entries render as a flat list.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
import type { OgSectionKey } from '../../content/og';

interface SectionEntry {
  slug: string;
  title: Record<Locale, string>;
  summary: Record<Locale, string>;
  group?: Record<Locale, string>;
}
interface SectionStrings { metaTitle: string; metaDesc: string; h1: string; tagline: string; emptyHtml: string }

export interface Props {
  locale: Locale;
  base: string;                       // e.g. '/concepts'
  strings: SectionStrings;            // localized UI strings for this section
  groups: { group: string | null; items: SectionEntry[] }[];
  sectionKey: OgSectionKey;
}
const { locale, base, strings, groups, sectionKey } = Astro.props;
const t = ui[locale];
const empty = strings.emptyHtml.replace('%FG%', localizeHref('/field-guide', locale));
const isEmpty = groups.length === 0 || groups.every(g => g.items.length === 0);

// Stable anchor ids for the group navigator.
//
// Slugify the localized label so English gets shareable anchors
// (#ai-foundations). Chinese labels reduce to almost nothing — both
// "AI 基础" and "智能体 AI" slugify to "ai" — so de-duplicate against ids
// already taken and fall back to a positional id. Without that, two groups
// on the zh page would share an anchor and one would be unreachable.
const usedIds = new Set<string>();
const groupIds = groups.map((g, i) => {
  const slug = (g.group ?? '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  let id = slug || `group-${i + 1}`;
  if (usedIds.has(id)) id = `${id}-${i + 1}`;
  usedIds.add(id);
  return id;
});
// Only worth showing when there is more than one destination to jump to.
const showGroupNav = !isEmpty && groups.filter(g => g.group).length > 1;
---
<BaseLayout title={strings.metaTitle} description={strings.metaDesc} locale={locale} image={ogImageFor(sectionKey, locale)} pagefindFilter={pagefindFilterFor(sectionKey, locale)}>
  <section class="hero">
    <div class="kicker">{strings.h1}</div>
    <h1>{strings.h1}</h1>
    <p class="lede">{strings.tagline}</p>
  </section>
  {/* Horizontal padding stays literal 20px: the "start here" .callout.start
      rendered via <slot name="prelude"> (ReadingPathCallout) escapes this
      padding with `margin: 20px -20px` in guide.css, and that -20px is
      intentionally left un-tokenized. The two must match or the callout
      over/under-shoots the viewport edge at mobile widths. */}
  <section class="wrap" style="padding:var(--s-5) 20px;">
    <slot name="prelude" />
    {showGroupNav && (
      <nav class="group-nav" aria-label={t.groupNav.aria}>
        <span class="group-nav-label">{t.groupNav.label}</span>
        <ul class="group-nav-list">
          {groups.map((g, i) => g.group && (
            <li>
              <a href={`#${groupIds[i]}`}>
                <span class="group-nav-name">{g.group}</span>
                <span class="group-nav-count">{g.items.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {isEmpty
      ? <p class="lede" set:html={empty} />
      : groups.map((g, i) => (
          <div class="toc-part" id={g.group ? groupIds[i] : undefined}>
            {g.group && <div class="toc-part-label"><span class="name">{g.group}</span><span class="meta">{g.items.length}</span></div>}
            <ul class="toc-list" style="list-style:none;padding:0;margin:0;">
              {g.items.map(e => (
                <li style="padding:var(--s-3) 0;border-bottom:1px solid var(--border-soft);">
                  <a class="entry-link" href={localizeHref(`${base}/${e.slug}`, locale)} style="text-decoration:none;color:var(--ink);display:block;">
                    <div style="font-family:var(--font-display);font-size:var(--t-md);line-height:var(--lh-md);">{e.title[locale]}</div>
                    <div style="color:var(--muted);font-size:var(--t-sm);line-height:var(--lh-sm);margin-top:var(--s-1);">{e.summary[locale]}</div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
  </section>
</BaseLayout>
<style is:global>
  /* .entry-link's hover/focus accent treatment is shared site-wide now
     (site.css) — nothing section-index-specific left to add here. */
  /* Empty-state CTA link is small body text — use the AA-contrast accent
     (overrides the inline color in the i18n emptyHtml string). */
  .lede a { color: var(--accent-ink) !important; }

  /* ---- Group navigator ------------------------------------------------
     The Concepts index lists all 50 entries on one page (deliberately — it
     reads as an encyclopedia, and the reading-path callout above assumes
     you can see the whole thing). At 9.2 phone-screens that left no way to
     reach a group without scrolling past everything before it. This gives
     each group a direct target.

     Deliberately NOT sticky: the site header is already sticky at
     --nav-h, and the redesign just reclaimed ~99px of phone screen —
     spending it again on a second permanent bar would undo that. The
     navigator's job is orientation on arrival, which it does from the top
     of the page. */
  .group-nav {
    margin: 0 0 var(--s-6);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--border-soft);
  }
  .group-nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    line-height: var(--lh-2xs);
    letter-spacing: calc(0.12em * var(--track-mul));
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: var(--s-3);
  }
  .group-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .group-nav-list a {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;             /* primary navigation — full touch target */
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
  }
  .group-nav-list a:hover { border-color: var(--accent); color: var(--accent-ink); }
  .group-nav-list a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .group-nav-name {
    font-family: var(--font-display);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }
  .group-nav-count {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    line-height: 1;
    color: var(--muted);
  }
  /* Anchor jumps must clear the sticky header, or the group label lands
     underneath it and the reader appears to have jumped into the middle of
     the previous group. */
  .toc-part[id] { scroll-margin-top: calc(var(--nav-h) + var(--s-4)); }
</style>
