---
import SectionIndexView from './SectionIndexView.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { groupedEntries } from '../../content/deep-dives/manifest';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const groups = groupedEntries(locale);
---
<SectionIndexView locale={locale} base="/deep-dives" strings={t.deepDives} groups={groups} />
