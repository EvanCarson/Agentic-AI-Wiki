---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../BlogCard.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { postsByTag, allTags } from '../../content/blogs/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';

export interface Props { tag: string; locale?: Locale }
const { tag, locale = 'en' } = Astro.props;
const t = ui[locale];
const tags = allTags();
if (!tags.includes(tag)) throw new Error(`Unknown blog tag: ${tag}`);
const posts = postsByTag(tag);

const metaTitle = t.blog.tagMetaTitle.replace('[TAG]', tag);
const metaDesc  = t.blog.tagMetaDesc.replace('[TAG]', tag);
---
<BaseLayout title={metaTitle} description={metaDesc} locale={locale} image={ogImageFor('blog', locale)} pagefindFilter={pagefindFilterFor('blog', locale)}>
  <section class="hero">
    <div class="kicker">{t.blog.h1}</div>
    <h1>{t.blog.taggedWith}: {tag}</h1>
    <p class="lede"><a href={localizeHref('/blogs', locale)} style="color:var(--accent);text-decoration:none;">{t.blog.backToBlog}</a></p>
  </section>
  <section class="wrap" style="padding:28px 20px;">
    <div style="display:grid;gap:14px;">
      {posts.map(p => <BlogCard post={p} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
