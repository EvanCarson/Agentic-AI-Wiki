---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingPathCallout from '../ReadingPathCallout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { GROUPS } from '../../content/playbooks/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
---
<BaseLayout title={t.playbooks.metaTitle} description={t.playbooks.metaDesc} locale={locale} image={ogImageFor('playbooks', locale)} pagefindFilter={pagefindFilterFor('playbooks', locale)}>
  <section class="hero">
    <div class="kicker">{t.playbooks.h1}</div>
    <h1>{t.playbooks.h1}</h1>
    <p class="lede">{t.playbooks.tagline}</p>
  </section>
  <section class="wrap" style="padding:28px 20px;">
    <ReadingPathCallout locale={locale} mode="playbooks" />
    <div class="toc-list" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:24px;">
      {GROUPS.map(g => (
        <a class="entry-link" href={localizeHref(`/playbooks/${g.key}`, locale)}
           style="text-decoration:none;color:var(--ink);display:block;padding:14px;border:1px solid var(--border-soft);border-radius:8px;">
          <div style="font-family:var(--font-display);font-size:var(--t-md);line-height:var(--lh-md);">{g.name[locale]}</div>
          <div style="color:var(--muted);font-size:var(--t-sm);line-height:var(--lh-sm);margin-top:4px;">{g.groupSummary[locale]}</div>
          <div style="color:var(--muted);font-size:var(--t-xs);line-height:var(--lh-xs);margin-top:8px;">{g.entries.length} {locale === 'zh' ? '篇' : g.entries.length === 1 ? 'essay' : 'essays'}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
