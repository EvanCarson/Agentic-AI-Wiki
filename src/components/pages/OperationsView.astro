---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingPathCallout from '../ReadingPathCallout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { GROUPS } from '../../content/operations/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
---
<BaseLayout title={t.operations.metaTitle} description={t.operations.metaDesc} locale={locale} image={ogImageFor('operations', locale)} pagefindFilter={pagefindFilterFor('operations', locale)}>
  <section class="hero">
    <div class="kicker">{t.operations.h1}</div>
    <h1>{t.operations.h1}</h1>
    <p class="lede">{t.operations.tagline}</p>
  </section>
  <section class="wrap" style="padding:28px 20px;">
    <ReadingPathCallout locale={locale} mode="operations" />
    <div class="toc-list" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:24px;">
      {GROUPS.map(g => (
        <a class="entry-link" href={localizeHref(`/operations/${g.key}`, locale)}
           style="text-decoration:none;color:var(--ink);display:block;padding:14px;border:1px solid var(--border-soft);border-radius:8px;">
          <div style="font-family:'Fraunces',serif;font-size:19px;">{g.name[locale]}</div>
          <div style="color:var(--muted);font-size:14px;line-height:1.45;margin-top:4px;">{g.groupSummary[locale]}</div>
          <div style="color:var(--muted);font-size:13px;margin-top:8px;">{g.entries.length} {locale === 'zh' ? '篇' : g.entries.length === 1 ? 'essay' : 'essays'}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
