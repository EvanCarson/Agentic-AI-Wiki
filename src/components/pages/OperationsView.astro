---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingPathCallout from '../ReadingPathCallout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { GROUPS } from '../../content/operations/manifest';
import { ogImageFor, pagefindFilterFor } from '../../lib/og';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
---
<BaseLayout title={t.operations.metaTitle} description={t.operations.metaDesc} locale={locale} image={ogImageFor('operations', locale)} pagefindFilter={pagefindFilterFor('operations', locale)}>
  <section class="hero">
    <div class="kicker">{t.operations.h1}</div>
    <h1>{t.operations.h1}</h1>
    <p class="lede">{t.operations.tagline}</p>
  </section>
  {/* Horizontal padding stays literal 20px: ReadingPathCallout renders
      .callout.start, which escapes this padding via `margin: 20px -20px`
      in guide.css (that -20px is intentionally left un-tokenized). The two
      must match or the callout over/under-shoots the viewport edge at
      mobile widths. */}
  <section class="wrap" style="padding:var(--s-5) 20px;">
    <ReadingPathCallout locale={locale} mode="operations" />
    <div class="toc-list" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--s-3);margin-top:var(--s-5);">
      {GROUPS.map(g => (
        <a class="entry-link" href={localizeHref(`/operations/${g.key}`, locale)}
           style="text-decoration:none;color:var(--ink);display:block;padding:var(--s-3);border:1px solid var(--border-soft);border-radius:6px;">
          <div style="font-family:var(--font-display);font-size:var(--t-md);line-height:var(--lh-md);">{g.name[locale]}</div>
          <div style="color:var(--muted);font-size:var(--t-sm);line-height:var(--lh-sm);margin-top:var(--s-1);">{g.groupSummary[locale]}</div>
          <div style="color:var(--muted);font-size:var(--t-xs);line-height:var(--lh-xs);margin-top:var(--s-2);">{g.entries.length} {locale === 'zh' ? '篇' : g.entries.length === 1 ? 'essay' : 'essays'}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
