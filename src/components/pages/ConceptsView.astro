---
import SectionIndexView from './SectionIndexView.astro';
import type { Locale } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { groupedEntries } from '../../content/concepts/manifest';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const groups = groupedEntries(locale);
---
<SectionIndexView locale={locale} base="/concepts" strings={t.concepts} groups={groups} />
