---
// About: the daily service. The page's claim is that a scheduled agent drafts
// part of the site, so it shows the agent's timetable as evidence: a
// departures board of the last seven content batches (read from GitHub at
// build time by lib/batches.ts, falling back to the changelog), then the six
// stops every batch calls at, then how it is written and who maintains it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
import { CHANGELOG } from '../../content/changelog';
import { loadBatches, type BatchStop } from '../../lib/batches.ts';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const fill = (s: string) => s
  .replace('%CHANGELOG%', localizeHref('/changelog', locale))
  .replace('%LLMS%', localizeHref('/llms.txt', locale));

const batches = await loadBatches(CHANGELOG);

const lineName: Record<string, string> = {
  fg: t.nav.fieldGuide, bk: t.nav.books, co: t.nav.concepts, dd: t.nav.deepDives,
  pb: t.nav.playbooks, op: t.nav.operations, bl: t.nav.blog,
};
const stopLabel = (s: BatchStop) =>
  s.line === 'bl' && s.count && s.count > 1
    ? t.about.board.blogCount.replace('{n}', String(s.count))
    : lineName[s.line];

const dayFmt = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', { day: 'numeric', month: locale === 'zh' ? 'long' : 'short', timeZone: 'UTC' });
const longFmt = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const day = (iso: string) => dayFmt.format(new Date(`${iso}T00:00:00Z`));

const foot = batches.total && batches.since
  ? t.about.board.foot
      .replace('{n}', String(batches.total))
      .replace('{date}', longFmt.format(new Date(`${batches.since}T00:00:00Z`)))
  : t.about.board.footFallback;
---
<BaseLayout title={`${t.about.kicker} — ${t.brand}`} description={t.about.metaDesc} locale={locale}>
  <section class="hero about-hero">
    <div class="wrap">
      <h1>{t.about.h1}</h1>
      <p class="about-standfirst">{t.about.standfirst}</p>
    </div>
  </section>
  <div class="wrap about-body">
    <section class="board" aria-labelledby="board-h" data-source={batches.source}>
      <div class="board-top">
        <h2 class="board-title" id="board-h">{t.about.board.title}</h2>
        <p class="board-departs">{t.about.board.departs}</p>
      </div>
      <div class="board-scroll" role="region" aria-label={t.about.board.region} tabindex="0">
        <table class="board-table" aria-labelledby="board-h">
          <thead>
            <tr>
              <th scope="col">{t.about.board.date}</th>
              <th scope="col">{t.about.board.merged}</th>
              <th scope="col">{t.about.board.calls}</th>
              <th scope="col">{t.about.board.rebuilt}</th>
              <th scope="col">{t.about.board.pr}</th>
            </tr>
          </thead>
          <tbody>
            {batches.rows.map((r, i) => (
              <tr class={i === 0 ? 'is-now' : undefined}>
                <td class="board-mono"><time datetime={r.date}>{day(r.date)}</time></td>
                <td class="board-mono">
                  {r.time
                    ? <span class={i === 0 ? 'board-status' : undefined}>{r.time}</span>
                    : '—'}
                </td>
                <td>
                  <span class="board-calls">
                    {r.stops.map((s) => (
                      <span class="board-call" data-line={s.line}><span class="board-dot" aria-hidden="true"></span>{stopLabel(s)}</span>
                    ))}
                  </span>
                </td>
                <td>{r.rebuilt ?? '—'}</td>
                <td class="board-mono">
                  {r.pr ? <a class="board-pr" href={r.pr.url} rel="noopener">#{r.pr.number}</a> : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="board-foot" set:html={fill(foot)} />
    </section>

    <section class="about-section" aria-labelledby="stops-h">
      <h2 class="about-h2" id="stops-h">{t.about.stopsH}</h2>
      <ol class="about-stops">
        {t.about.stops.map((s) => (
          <li><b>{s.name}</b>{s.note}</li>
        ))}
      </ol>
    </section>

    <section class="about-section" aria-labelledby="written-h">
      <h2 class="about-h2" id="written-h">{t.about.authorshipH}</h2>
      <div class="about-prose"><p set:html={fill(t.about.authorshipHtml)} /></div>
    </section>

    <section class="about-section" aria-labelledby="maint-h">
      <h2 class="about-h2" id="maint-h">{t.about.maintainerH}</h2>
      <div class="about-prose">
        <p set:html={fill(t.about.maintainerHtml)} />
        <p set:html={fill(t.about.contactHtml)} />
      </div>
    </section>
  </div>
</BaseLayout>
