---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/index';
import { localizeHref } from '../../i18n/index';
import { ui } from '../../i18n/ui';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale];
const fill = (s: string) => s
  .replace('%FG%', localizeHref('/field-guide', locale))
  .replace('%CONCEPTS%', localizeHref('/concepts', locale))
  .replace('%DEEP%', localizeHref('/deep-dives', locale))
  .replace('%CHANGELOG%', localizeHref('/changelog', locale))
  .replace('%LLMS%', localizeHref('/llms.txt', locale));
const sections = [
  { h: t.about.missionH, html: fill(t.about.missionHtml) },
  { h: t.about.coveredH, html: fill(t.about.coveredHtml) },
  { h: t.about.maintainerH, html: fill(t.about.maintainerHtml) },
  // Sits directly under "who maintains it" because that is where a reader who
  // wants to know who wrote a page has already stopped. The README has said
  // a scheduled agent writes part of this site since the routine shipped;
  // the site itself did not, which is the wrong way round for a page carrying ads.
  { h: t.about.authorshipH, html: fill(t.about.authorshipHtml) },
  { h: t.about.contactH, html: fill(t.about.contactHtml) },
];
---
<BaseLayout title={`${t.about.kicker} — ${t.brand}`} description={t.about.metaDesc} locale={locale}>
  {/* Was the plainest page in the build — no hero, no rule, a 36px h1 in a
      655px column — on the one page where a reader decides whether to trust
      an anonymous wiki. This is the same .hero the five section indexes use:
      full-bleed, 56px display type, full-width ink rule. */}
  <section class="hero">
    <div class="kicker">{t.about.kicker}</div>
    <h1>{t.about.h1}</h1>
  </section>
  <section class="wrap wrap--prose about-body">
    {sections.map(s => (
      <section style="margin:var(--s-5) 0;">
        <h2 style="font-family:var(--font-display);font-weight:400;font-size:var(--t-lg);line-height:var(--lh-lg);margin:0 0 .4em;">{s.h}</h2>
        <p class="lede" style="margin:0;" set:html={s.html} />
      </section>
    ))}
  </section>
</BaseLayout>
