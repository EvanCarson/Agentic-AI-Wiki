---
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---
<aside class="chapter-toc" id="page-toc" data-pagefind-ignore hidden>
  <div class="chapter-toc-header">
    <button
      type="button"
      class="chapter-toc-toggle"
      aria-expanded="true"
      aria-controls="page-toc-list"
    >
      <span class="chapter-toc-label">{t.toc.heading}</span>
      <svg class="chapter-toc-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </div>
  <ol class="chapter-toc-list" id="page-toc-list"></ol>
</aside>

<script is:inline>
  (() => {
    const toc = document.getElementById('page-toc');
    const list = document.getElementById('page-toc-list');
    const toggle = toc && toc.querySelector('.chapter-toc-toggle');
    if (!toc || !list || !toggle) return;

    // Find the article element. ChapterLayout and SectionEntryLayout both
    // render <article set:html={body}> as a direct child of .chapter-main.
    const article = document.querySelector('.chapter-main article');
    if (!article) return;

    const headings = Array.from(article.querySelectorAll('h2, h3'));
    if (headings.length < 3) {
      // not worth a TOC
      return;
    }

    // Ensure each heading has a stable id so we can link to it.
    const slugify = (s) =>
      s.toLowerCase()
        .normalize('NFKD')
        .replace(/[^\w\s一-鿿]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .slice(0, 80) || 'section';

    const used = new Set();
    function uniqueId(base) {
      let id = base;
      let i = 2;
      while (used.has(id) || document.getElementById(id)) {
        id = base + '-' + i++;
      }
      used.add(id);
      return id;
    }

    for (const h of headings) {
      if (!h.id) h.id = uniqueId(slugify(h.textContent || ''));
      else used.add(h.id);
      const li = document.createElement('li');
      li.className = 'chapter-toc-item chapter-toc-' + h.tagName.toLowerCase();
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent || '';
      li.appendChild(a);
      list.appendChild(li);
    }

    // Reveal the TOC.
    toc.removeAttribute('hidden');

    // Active-section highlight via IntersectionObserver.
    const linkByHash = new Map();
    list.querySelectorAll('a[href^="#"]').forEach((a) => {
      linkByHash.set(a.getAttribute('href').slice(1), a);
    });

    let activeId = null;
    function setActive(id) {
      if (activeId === id) return;
      if (activeId) {
        const prev = linkByHash.get(activeId);
        if (prev) prev.parentElement.classList.remove('active');
      }
      activeId = id;
      if (activeId) {
        const next = linkByHash.get(activeId);
        if (next) next.parentElement.classList.add('active');
      }
    }

    const observer = new IntersectionObserver((entries) => {
      // Pick the topmost visible heading.
      const visible = entries
        .filter((e) => e.isIntersecting)
        .map((e) => e.target);
      if (visible.length > 0) {
        // Find the first visible heading by document order.
        let topMost = visible[0];
        for (const h of visible) {
          if (h.compareDocumentPosition(topMost) & Node.DOCUMENT_POSITION_FOLLOWING) {
            topMost = h;
          }
        }
        setActive(topMost.id);
        return;
      }
      // Nothing is intersecting (e.g. between headings) — find the last
      // heading above the viewport.
      const above = headings.filter((h) => h.getBoundingClientRect().top < 0);
      if (above.length > 0) setActive(above[above.length - 1].id);
    }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });
    headings.forEach((h) => observer.observe(h));

    // Mobile accordion toggle.
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      list.style.display = isOpen ? 'none' : '';
    });
  })();
</script>
