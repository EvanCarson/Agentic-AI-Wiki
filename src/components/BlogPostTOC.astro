---
// In-page TOC for blog post detail pages. Mounted in the LEFT rail (.chapter-side)
// instead of the right rail that PageTOC uses. Behaviourally identical to PageTOC:
// discovers h2/h3 in `article` inside `.chapter-main`, builds a linked list with
// stable ids, and runs an IntersectionObserver scroll-spy to highlight the active
// section. Uses the same `.chapter-toc-*` classes from site.css so the toggle,
// chevron, and item styles are shared for free — only the rail-specific overrides
// (border direction, top padding) are scoped here.
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---
<nav class="blog-toc" id="blog-post-toc" data-pagefind-ignore hidden>
  <div class="chapter-toc-header">
    <button
      type="button"
      class="chapter-toc-toggle"
      aria-expanded="true"
      aria-controls="blog-post-toc-list"
    >
      <span class="chapter-toc-label">{t.blog.onThisPage}</span>
      <svg class="chapter-toc-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </div>
  <ol class="chapter-toc-list" id="blog-post-toc-list"></ol>
</nav>

<style>
  /* Left-rail overrides. The shared .chapter-toc-* styles from site.css define
     most of the visual treatment. Here we only adjust what differs because this
     TOC sits on the LEFT (no border-left; optional border-right) and has its own
     top padding to align with the breadcrumb/header in .chapter-main. */
  .blog-toc {
    font-family: var(--font-body);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    color: var(--muted);
    padding-top: var(--s-4);
    /* No border-left — left-rail TOC sits flush against the shell gutter.
       A subtle border-right visually separates it from the main column. */
    border-right: 1px solid var(--border-softer);
    padding-right: var(--s-4);
  }
  .blog-toc[hidden] { display: none; }

  /* 900-1023px the rail is not a rail: site.css turns .chapter-side-blogtoc
     into a full-width in-flow block above the article, so the left-rail
     treatment above has to be undone — a border-RIGHT across the full column
     reads as a stray vertical line, and .chapter-shell drops its own padding
     below 1024px so the panel needs its own gutters.

     These rules live HERE, not in site.css, on purpose. Astro appends this
     component's scope class to every selector in this block, so the rules
     above are really `.blog-toc[data-astro-cid-…]` (0,2,0). A `.blog-toc`
     rule written in site.css is (0,1,0) and would lose regardless of source
     order — it would compute as if never declared. Same specificity, later in
     the same block, is what actually wins. This branch has been bitten by the
     scoped-vs-global cascade twice already. */
  @media (min-width: 900px) and (max-width: 1023.98px) {
    .blog-toc {
      border-right: 0;
      padding-top: var(--s-4);
      padding-bottom: var(--s-4);
      padding-left: var(--s-4);
      padding-right: var(--s-4);
    }
  }
</style>

<script is:inline>
  // NOTE: this <script> is inlined in the LEFT rail, which the parser reaches
  // BEFORE the .chapter-main <article>. If we ran the body synchronously the
  // article wouldn't exist yet — querySelector would return null and we'd bail.
  // Defer to DOMContentLoaded so the whole shell is parsed first.
  (() => {
  function init() {
    const toc = document.getElementById('blog-post-toc');
    const list = document.getElementById('blog-post-toc-list');
    const toggle = toc && toc.querySelector('.chapter-toc-toggle');
    if (!toc || !list || !toggle) return;

    // Blog layout renders <article set:html={body}> as a direct child of .chapter-main.
    const article = document.querySelector('.chapter-main article');
    if (!article) return;

    const headings = Array.from(article.querySelectorAll('h2, h3'));
    if (headings.length < 3) {
      // Not enough headings to warrant a TOC.
      return;
    }

    // Ensure each heading has a stable id so we can link to it.
    const slugify = (s) =>
      s.toLowerCase()
        .normalize('NFKD')
        .replace(/[^\w\s一-鿿]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .slice(0, 80) || 'section';

    const used = new Set();
    function uniqueId(base) {
      let id = base;
      let i = 2;
      while (used.has(id) || document.getElementById(id)) {
        id = base + '-' + i++;
      }
      used.add(id);
      return id;
    }

    for (const h of headings) {
      if (!h.id) h.id = uniqueId(slugify(h.textContent || ''));
      else used.add(h.id);
      const li = document.createElement('li');
      li.className = 'chapter-toc-item chapter-toc-' + h.tagName.toLowerCase();
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent || '';
      li.appendChild(a);
      list.appendChild(li);
    }

    // Reveal the TOC.
    toc.removeAttribute('hidden');

    // Active-section highlight via IntersectionObserver.
    const linkByHash = new Map();
    list.querySelectorAll('a[href^="#"]').forEach((a) => {
      linkByHash.set(a.getAttribute('href').slice(1), a);
    });

    let activeId = null;
    function setActive(id) {
      if (activeId === id) return;
      if (activeId) {
        const prev = linkByHash.get(activeId);
        if (prev) prev.parentElement.classList.remove('active');
      }
      activeId = id;
      if (activeId) {
        const next = linkByHash.get(activeId);
        if (next) next.parentElement.classList.add('active');
      }
    }

    const observer = new IntersectionObserver((entries) => {
      // Pick the topmost visible heading.
      const visible = entries
        .filter((e) => e.isIntersecting)
        .map((e) => e.target);
      if (visible.length > 0) {
        let topMost = visible[0];
        for (const h of visible) {
          if (h.compareDocumentPosition(topMost) & Node.DOCUMENT_POSITION_FOLLOWING) {
            topMost = h;
          }
        }
        setActive(topMost.id);
        return;
      }
      // Nothing is intersecting — find the last heading above the viewport.
      const above = headings.filter((h) => h.getBoundingClientRect().top < 0);
      if (above.length > 0) setActive(above[above.length - 1].id);
    }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });
    headings.forEach((h) => observer.observe(h));

    // ---- Open/closed state -------------------------------------------------
    // ONE writer for the pair. aria-expanded and the list's visibility are two
    // halves of a single state: a CSS-only hide that leaves aria-expanded="true"
    // tells a screen reader the list is open while sighted readers see it
    // closed, which is an accessibility defect rather than a shortcut. Both the
    // click handler and the breakpoint default drive this same function, so
    // there is no second mechanism to drift out of step with the first.
    //
    // The early return matters more than it looks: it makes setExpanded a true
    // no-op when the state already matches, so at every width except the
    // 900-1023px in-flow band this script touches NOTHING — no attribute
    // write, no inline style. That is what keeps the phone rendering
    // byte-identical, which is this branch's central promise.
    function setExpanded(open) {
      if ((toggle.getAttribute('aria-expanded') === 'true') === open) return;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      // The chevron rotation is already keyed on [aria-expanded="false"] in
      // site.css, so it follows for free.
      list.style.display = open ? '' : 'none';
    }

    toggle.addEventListener('click', () => {
      setExpanded(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // ---- Default state per band --------------------------------------------
    // 900-1023.98px the panel is not a rail: site.css puts it in flow above the
    // article. Expanded, that is one entry per heading — 1289px on a 40-heading
    // post, pushing the article's top edge to y=1852, roughly two screens of
    // contents before the first paragraph. So it defaults to CLOSED in that band
    // and the reader opens it. At 1024px and up it is a rail beside the article,
    // where its height costs the reader nothing, and it stays open exactly as it
    // has always been. Below 900px it is not rendered at all.
    //
    // The chapter TOC (PageTOC) deliberately does NOT do this: its worst case
    // site-wide is 9 entries and ~350px of displacement, which is fine expanded.
    // The two panels differ on purpose — see spec section 5.3.
    //
    // matchMedia, not a resize listener, and this is the part that keeps a
    // reader who opened the panel from being fought: `change` fires only when
    // the 1024px boundary is actually CROSSED, so dragging a window around
    // inside one band never touches the state. Crossing it re-applies the
    // default for the band being entered, which is what stops a rotated tablet
    // landing on a collapsed rail or an expanded 1289px panel.
    const inFlow = window.matchMedia('(min-width: 900px) and (max-width: 1023.98px)');
    const applyDefault = () => setExpanded(!inFlow.matches);
    applyDefault();
    if (inFlow.addEventListener) inFlow.addEventListener('change', applyDefault);
    else inFlow.addListener(applyDefault); // Safari < 14
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  })();
</script>
