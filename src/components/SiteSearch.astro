---
// Client-side site search powered by Pagefind (build-time index over the
// emitted dist/ HTML — see `npm run build:search`). The Pagefind UI assets
// (/pagefind/pagefind-ui.js + .css) are emitted by the `pagefind` CLI into
// dist/pagefind/ and are NOT present during `astro dev`; the trigger fails
// gracefully (logs once) when the index is absent.
//
// Pagefind reads the page's <html lang> ("en" / "zh-Hans", set in
// BaseLayout) and only returns same-locale results, so EN and ZH search are
// naturally separated with a single shared index.
//
// JS footprint is lazy: nothing loads until the user first opens search
// (click or "/" / Cmd/Ctrl-K). This whole region is excluded from the index.
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui[locale].search;
---
<div class="site-search" data-pagefind-ignore>
  <button
    type="button"
    class="site-search-trigger"
    id="site-search-trigger"
    aria-label={t.open}
    aria-haspopup="dialog"
    title={t.open}
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <span class="site-search-label">{t.label}</span>
  </button>

  <div class="site-search-modal" id="site-search-modal" role="dialog" aria-modal="true" aria-label={t.open} hidden>
    <div class="site-search-backdrop" id="site-search-backdrop"></div>
    <div class="site-search-panel" role="document">
      <button type="button" class="site-search-close" id="site-search-close" aria-label={t.close}>&times;</button>
      <div id="site-search-pagefind" class="site-search-results"></div>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    lang: locale === 'zh' ? 'zh-Hans' : 'en',
    strings: {
      placeholder: t.placeholder,
      clear_search: t.clear,
      load_more: t.loadMore,
      search_label: t.searchLabel,
      filters_label: t.filtersLabel,
      zero_results: t.zeroResults,
      many_results: t.manyResults,
      one_result: t.oneResult,
      alt_search: t.altSearch,
      search_suggestion: t.searchSuggestion,
      searching: t.searching,
    },
  }}
>
  (() => {
    const trigger = document.getElementById('site-search-trigger');
    const modal = document.getElementById('site-search-modal');
    const backdrop = document.getElementById('site-search-backdrop');
    const closeBtn = document.getElementById('site-search-close');
    if (!trigger || !modal || !backdrop || !closeBtn) return;

    let loaded = false;
    let loadingPromise = null;
    let lastFocus = null;

    function loadAsset(tag, attrs) {
      return new Promise((resolve, reject) => {
        const el = document.createElement(tag);
        Object.assign(el, attrs);
        el.addEventListener('load', () => resolve(true), { once: true });
        el.addEventListener('error', () => reject(new Error('asset failed: ' + (attrs.href || attrs.src))), { once: true });
        document.head.appendChild(el);
      });
    }

    function ensureUI() {
      if (loaded) return Promise.resolve(true);
      if (loadingPromise) return loadingPromise;
      loadingPromise = (async () => {
        await loadAsset('link', { rel: 'stylesheet', href: '/pagefind/pagefind-ui.css' });
        await import('/pagefind/pagefind-ui.js');
        // PagefindUI is exposed as a global by the bundled UI script.
        if (typeof window.PagefindUI !== 'function') {
          throw new Error('PagefindUI unavailable');
        }
        new window.PagefindUI({
          element: '#site-search-pagefind',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: strings,
        });
        loaded = true;
        return true;
      })().catch((err) => {
        loadingPromise = null;
        console.warn('[site-search] Pagefind index not available (run `npm run build:search`).', err);
        throw err;
      });
      return loadingPromise;
    }

    function open() {
      lastFocus = document.activeElement;
      modal.hidden = false;
      document.documentElement.classList.add('site-search-open');
      ensureUI()
        .then(() => {
          const input = modal.querySelector('input[type="text"], .pagefind-ui__search-input');
          if (input) input.focus();
        })
        .catch(() => {
          /* Already warned; leave the modal open with an empty (unstyled-safe) box. */
        });
    }

    function close() {
      modal.hidden = true;
      document.documentElement.classList.remove('site-search-open');
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    trigger.addEventListener('click', open);
    backdrop.addEventListener('click', close);
    closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      const tag = (e.target && e.target.tagName) || '';
      const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable);
      if (modal.hidden && !typing && e.key === '/') {
        e.preventDefault();
        open();
      } else if (!modal.hidden && e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        modal.hidden ? open() : close();
      }
    });
  })();
</script>
