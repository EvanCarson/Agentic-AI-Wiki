---
import BaseLayout from './BaseLayout.astro';
import ChapterSidebar from '../components/ChapterSidebar.astro';
import PageTOC from '../components/PageTOC.astro';
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { CHAPTERS } from '../content/field-guide/manifest';
import { ogImageFor, pagefindFilterFor } from '../lib/og';
import { readingTimeFromHtml } from '../lib/reading-time';
export interface Props { slug: string; locale?: Locale }
const { slug, locale = 'en' } = Astro.props;
const t = ui[locale];
const idx = CHAPTERS.findIndex(c => c.slug === slug);
const ch = CHAPTERS[idx];
if (!ch) throw new Error(`Unknown chapter slug: ${slug}`);
const prev = idx > 0 ? CHAPTERS[idx - 1] : null;
const next = idx < CHAPTERS.length - 1 ? CHAPTERS[idx + 1] : null;
const label = (c: typeof ch) => `${c.partRoman}·${parseInt(c.num, 10)} ${c.title[locale]}`;
const bodies = import.meta.glob('../content/field-guide/*/*.html', { query: '?raw', import: 'default', eager: true });
const body = bodies[`../content/field-guide/${locale}/${ch.page}.html`] as string;
// One measured chapter runs 7,086 words / 30,042px with no length signal
// anywhere on the page. Derived from the fragment, so it tracks edits.
const readingMin = readingTimeFromHtml(body);
const chTitle = ch.title[locale];
const partNm = ch.partName[locale];
const title = `${chTitle} — ${t.seriesTitle}`;
---
<BaseLayout title={title} description={`${partNm}: ${chTitle}.`} locale={locale} image={ogImageFor('fieldGuide', locale)} pagefindFilter={pagefindFilterFor('fieldGuide', locale)}>
  <div class="chapter-shell">
    <aside class="chapter-side" data-pagefind-ignore><ChapterSidebar current={ch.slug} locale={locale} /></aside>
    <div class="chapter-main">
      <div class="breadcrumb" data-pagefind-ignore>
        <a href={localizeHref('/field-guide', locale)}>{t.breadcrumbRoot}</a> / {ch.partRoman} {partNm} / {chTitle}
      </div>
      {readingMin && <p class="page-meta" data-pagefind-ignore>{readingMin} {t.blog.readingTime}</p>}
      <article set:html={body} />
      {/* Empty hidden span at first/last chapter keeps the remaining card at 50% width (legacy .page-nav-btn flex:1). */}
      <nav class="page-nav" data-pagefind-ignore>
        {prev
          ? <a class="page-nav-btn" href={localizeHref(`/field-guide/${prev.slug}`, locale)}><div class="dir">{t.prev}</div><div class="title">{label(prev)}</div></a>
          : <span class="page-nav-btn" aria-hidden="true" style="visibility:hidden"></span>}
        {next
          ? <a class="page-nav-btn next" href={localizeHref(`/field-guide/${next.slug}`, locale)}><div class="dir">{t.next}</div><div class="title">{label(next)}</div></a>
          : <span class="page-nav-btn" aria-hidden="true" style="visibility:hidden"></span>}
      </nav>
    </div>
    <PageTOC locale={locale} />
  </div>
  <script is:inline>
    function switchTab(button) {
      const targetApi = button.dataset.api;
      document.querySelectorAll('.code-tabs').forEach(group => {
        const matching = group.querySelector('[data-api="' + targetApi + '"]');
        if (matching) {
          group.querySelectorAll('.code-tab').forEach(t => t.classList.remove('active'));
          matching.classList.add('active');
          let n = group.nextElementSibling;
          while (n && n.classList.contains('code-content')) {
            n.classList.toggle('active', n.dataset.api === targetApi);
            n = n.nextElementSibling;
          }
        }
      });
    }
    window.switchTab = switchTab;
  </script>
</BaseLayout>
