---
import SectionEntryLayout from './SectionEntryLayout.astro';
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
import { ENTRIES, GROUPS, entryBySlug, groupedEntries } from '../content/deep-dives/manifest';
export interface Props { slug: string; groupKey: string; locale?: Locale }
const { slug, locale = 'en' } = Astro.props;
const t = ui[locale];
const entry = entryBySlug(slug);
if (!entry) throw new Error(`Unknown deep-dive slug: ${slug}`);
const bodies = import.meta.glob('../content/deep-dives/*/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const linkFor = (e: { slug: string }) => {
  const g = GROUPS.find(g => g.entries.some(x => x.slug === e.slug));
  return `/deep-dives/${g!.key}/${e.slug}`;
};
---
<SectionEntryLayout
  showReadingTime
  locale={locale}
  base="/deep-dives"
  rootLabel={t.deepDives.h1}
  ariaLabel={t.deepDives.h1}
  prevLabel={t.prev}
  nextLabel={t.next}
  entry={entry}
  entries={ENTRIES}
  groups={groupedEntries(locale)}
  bodies={bodies}
  bodyDir="../content/deep-dives"
  linkFor={linkFor}
  sectionKey="deepDives"
/>
