---
import SectionEntryLayout from './SectionEntryLayout.astro';
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
import { ENTRIES, GROUPS, entryBySlug, groupedEntries } from '../content/playbooks/manifest';
export interface Props { slug: string; groupKey: string; locale?: Locale }
const { slug, locale = 'en' } = Astro.props;
const t = ui[locale];
const entry = entryBySlug(slug);
if (!entry) throw new Error(`Unknown playbook slug: ${slug}`);
const bodies = import.meta.glob('../content/playbooks/*/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const linkFor = (e: { slug: string }) => {
  const g = GROUPS.find(g => g.entries.some(x => x.slug === e.slug));
  return `/playbooks/${g!.key}/${e.slug}`;
};
---
<SectionEntryLayout
  locale={locale}
  base="/playbooks"
  rootLabel={t.playbooks.h1}
  ariaLabel={t.playbooks.h1}
  prevLabel={t.prev}
  nextLabel={t.next}
  entry={entry}
  entries={ENTRIES}
  groups={groupedEntries(locale)}
  bodies={bodies}
  bodyDir="../content/playbooks"
  linkFor={linkFor}
/>
