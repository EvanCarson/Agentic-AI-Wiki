---
import SectionEntryLayout from './SectionEntryLayout.astro';
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
import { ENTRIES, entryBySlug, groupedEntries } from '../content/concepts/manifest';
export interface Props { slug: string; locale?: Locale }
const { slug, locale = 'en' } = Astro.props;
const t = ui[locale];
const entry = entryBySlug(slug);
if (!entry) throw new Error(`Unknown concept slug: ${slug}`);
const bodies = import.meta.glob('../content/concepts/*/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
---
<SectionEntryLayout
  locale={locale}
  base="/concepts"
  rootLabel={t.concepts.h1}
  ariaLabel={t.concepts.h1}
  prevLabel={t.prev}
  nextLabel={t.next}
  entry={entry}
  entries={ENTRIES}
  groups={groupedEntries(locale)}
  bodies={bodies}
  bodyDir="../content/concepts"
  sectionKey="concepts"
/>
