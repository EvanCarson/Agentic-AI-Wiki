---
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../i18n/index';
import { ui } from '../i18n/ui';
export interface Props { title: string; description: string; pubDate: Date; locale?: Locale }
const { title, description, pubDate, locale = 'en' } = Astro.props;
const t = ui[locale];
---
<BaseLayout title={`${title} — ${t.brand}`} description={description} locale={locale}>
  <article class="wrap" style="padding:24px 20px;">
    <div class="kicker">{pubDate.toISOString().slice(0, 10)}</div>
    <h1 style="font-family:'Fraunces',serif;font-weight:400;font-size:32px;">{title}</h1>
    <slot />
  </article>
</BaseLayout>
