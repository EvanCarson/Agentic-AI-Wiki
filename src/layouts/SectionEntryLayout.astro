---
// Shared detail layout for Concepts / Deep-Dives entries. Mirrors
// ChapterLayout: sidebar + breadcrumb + <article set:html> + prev/next nav.
// The HTML fragment + grouped entry list are resolved by the section-specific
// wrapper (which owns its static import.meta.glob) and passed in here.
import BaseLayout from './BaseLayout.astro';
import SectionSidebar from '../components/SectionSidebar.astro';
import PageTOC from '../components/PageTOC.astro';
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { ogImageFor, pagefindFilterFor } from '../lib/og';
import { readingTimeFromHtml } from '../lib/reading-time';
import type { OgSectionKey } from '../content/og';

interface SectionEntry {
  page: string;
  slug: string;
  title: Record<Locale, string>;
  summary: Record<Locale, string>;
  group?: Record<Locale, string>;
}
export interface Props {
  locale: Locale;
  base: string;                 // e.g. '/concepts'
  rootLabel: string;            // breadcrumb root + meta-title suffix
  /** Show an estimated reading time. Off for Concepts, which is a glossary
      of short entries where "1 min read" on every one is noise. */
  showReadingTime?: boolean;
  ariaLabel: string;            // sidebar aria-label
  prevLabel: string;
  nextLabel: string;
  entry: SectionEntry;
  entries: SectionEntry[];      // flat ordered list (for prev/next)
  groups: { group: string | null; items: SectionEntry[] }[];
  /** Map keyed `<base-dir>/<locale>/<page>.html` → raw HTML string. */
  bodies: Record<string, string>;
  bodyDir: string;              // glob dir prefix, e.g. '../content/concepts'
  /** How to construct an href for an entry. Defaults to `${base}/${entry.slug}`. */
  linkFor?: (e: SectionEntry) => string;
  /** OG section key — drives og:image. Required so detail layouts can't drift. */
  sectionKey: OgSectionKey;
}
const { locale, base, rootLabel, ariaLabel, prevLabel, nextLabel, entry, entries, groups, bodies, bodyDir, linkFor, sectionKey, showReadingTime = false } = Astro.props;
const t = ui[locale];

const idx = entries.findIndex(e => e.slug === entry.slug);
const prev = idx > 0 ? entries[idx - 1] : null;
const next = idx >= 0 && idx < entries.length - 1 ? entries[idx + 1] : null;

// Graceful locale fallback: prefer this locale's fragment; if absent, fall
// back to the other locale's fragment so the build never crashes.
const other: Locale = locale === 'en' ? 'zh' : 'en';
const body =
  (bodies[`${bodyDir}/${locale}/${entry.page}.html`] as string | undefined) ??
  (bodies[`${bodyDir}/${other}/${entry.page}.html`] as string | undefined) ??
  '';

const readingMin = showReadingTime ? readingTimeFromHtml(body) : null;
const entryTitle = entry.title[locale];
const groupNm = entry.group ? entry.group[locale] : null;
const title = `${entryTitle} — ${rootLabel}`;
const label = (e: SectionEntry) => e.title[locale];

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entryTitle,
  description: entry.summary[locale],
  inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
  url: pageUrl,
};
---
<BaseLayout title={title} description={entry.summary[locale]} locale={locale} image={ogImageFor(sectionKey, locale)} pagefindFilter={pagefindFilterFor(sectionKey, locale)}>
  {/* Escape < as the JSON unicode escape \u003c so a </script> in
      manifest-derived data cannot break out of this ld+json block.
      fromCharCode(92) builds a real backslash: a plain "\u003c"
      literal is parsed by JS as < itself, silently defeating this. */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, String.fromCharCode(92) + 'u003c')} is:inline />
  <div class="chapter-shell">
    <aside class="chapter-side" data-pagefind-ignore>
      <SectionSidebar locale={locale} base={base} ariaLabel={ariaLabel} current={entry.slug} groups={groups} linkFor={linkFor} />
    </aside>
    <div class="chapter-main">
      <div class="breadcrumb" data-pagefind-ignore>
        <a href={localizeHref(base, locale)}>{rootLabel}</a> / {groupNm ? `${groupNm} / ` : ''}{entryTitle}
      </div>
      <nav class="mobile-section-nav" aria-label={ariaLabel} data-pagefind-ignore>
        <a href={localizeHref(base, locale)}>{locale === 'zh' ? `浏览全部${rootLabel} →` : `Browse all ${rootLabel} →`}</a>
      </nav>
      <h1 class="visually-hidden">{entryTitle}</h1>
      {readingMin && <p class="page-meta" data-pagefind-ignore>{readingMin} {t.blog.readingTime}</p>}
      <article set:html={body} />
      <nav class="page-nav" data-pagefind-ignore>
        {prev
          ? <a class="page-nav-btn" href={localizeHref(linkFor ? linkFor(prev) : `${base}/${prev.slug}`, locale)}><div class="dir">{prevLabel}</div><div class="title">{label(prev)}</div></a>
          : <span class="page-nav-btn" aria-hidden="true" style="visibility:hidden"></span>}
        {next
          ? <a class="page-nav-btn next" href={localizeHref(linkFor ? linkFor(next) : `${base}/${next.slug}`, locale)}><div class="dir">{nextLabel}</div><div class="title">{label(next)}</div></a>
          : <span class="page-nav-btn" aria-hidden="true" style="visibility:hidden"></span>}
      </nav>
    </div>
    <PageTOC locale={locale} />
  </div>
  <script is:inline>
    function switchTab(button) {
      const targetApi = button.dataset.api;
      document.querySelectorAll('.code-tabs').forEach(group => {
        const matching = group.querySelector('[data-api="' + targetApi + '"]');
        if (matching) {
          group.querySelectorAll('.code-tab').forEach(t => t.classList.remove('active'));
          matching.classList.add('active');
          let n = group.nextElementSibling;
          while (n && n.classList.contains('code-content')) {
            n.classList.toggle('active', n.dataset.api === targetApi);
            n = n.nextElementSibling;
          }
        }
      });
    }
    window.switchTab = switchTab;
  </script>
</BaseLayout>
