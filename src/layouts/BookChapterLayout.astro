---
import { withStandfirst, withStepRings } from '../lib/standfirst';
// One chapter of a book. Modelled on ChapterLayout (the Field Guide's), with
// three differences: the sidebar shows planned chapters greyed out, prev/next
// skip anything not yet published, and the foot of the page lists the other
// chapters that link here (src/lib/book-backlinks.ts).
import BaseLayout from './BaseLayout.astro';
import BookSidebar from '../components/BookSidebar.astro';
import PageTOC from '../components/PageTOC.astro';
import type { Locale } from '../i18n/index';
import { localizeHref } from '../i18n/index';
import { ui } from '../i18n/ui';
import { bookBySlug, bookChapters } from '../content/books/index';
import { buildChapterBacklinks } from '../lib/book-backlinks';
import { ogImageFor, pagefindFilterFor } from '../lib/og';
import { readingTimeFromHtml } from '../lib/reading-time';
export interface Props { book: string; chapter: string; locale?: Locale }
const { book: bookSlug, chapter, locale = 'en' } = Astro.props;
const t = ui[locale];
const book = bookBySlug(bookSlug);
if (!book) throw new Error(`Unknown book: ${bookSlug}`);
const published = bookChapters(book).filter(c => c.status === 'published');
const idx = published.findIndex(c => c.slug === chapter);
const ch = published[idx];
if (!ch) throw new Error(`Chapter not published: ${bookSlug}/${chapter}`);
const prev = idx > 0 ? published[idx - 1] : null;
const next = idx < published.length - 1 ? published[idx + 1] : null;

const fragments = import.meta.glob('../content/books/*/*/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
// Thesis-sentence openers get a visible title and a standfirst; see lib/standfirst.
const prepared = withStandfirst(fragments[`../content/books/${bookSlug}/${locale}/${chapter}.html`] as string, ch.title[locale]);
const standfirst = prepared.standfirst;
const body = withStepRings(prepared.body, locale);
if (!body) throw new Error(`Missing ${locale} fragment for ${bookSlug}/${chapter}`);
const bookFragments = Object.fromEntries(Object.entries(fragments).filter(([p]) => p.startsWith(`../content/books/${bookSlug}/`)));
const citedBy = buildChapterBacklinks(bookFragments, bookSlug).get(chapter) ?? new Set<string>();
const referencedIn = published.filter(c => citedBy.has(c.slug));

const readingMin = readingTimeFromHtml(body);
const href = (slug: string) => localizeHref(`/books/${bookSlug}/${slug}/`, locale);
// The visible header is the fragment's own .phase block (phase-num + week
// line + h2), the skeleton every other section uses; this string is what its
// .week line should read, exported to authors via the book bible.
const kicker = [
  ch.part.roman !== '—' ? t.books.partLabel(ch.part.roman) : null,
  ch.part.name[locale],
  t.books.chapterLabel(ch.num) || null,
].filter(Boolean).join(' · ');
const navLabel = (c: typeof ch) => `${c.num ? `${c.num}. ` : ''}${c.title[locale]}`;
const title = `${ch.title[locale]} — ${book.title[locale]}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: ch.title[locale],
  description: ch.summary[locale],
  inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  isPartOf: { '@type': 'Book', name: `${book.title[locale]}: ${book.subtitle[locale]}`, url: new URL(localizeHref(`/books/${bookSlug}/`, locale), Astro.site).toString() },
};
---
<BaseLayout title={title} description={ch.summary[locale]} locale={locale} image={ogImageFor('books', locale)} pagefindFilter={pagefindFilterFor('books', locale)}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, String.fromCharCode(92) + 'u003c')} is:inline />
  <div class="chapter-shell">
    <aside class="chapter-side" data-pagefind-ignore><BookSidebar book={book} current={chapter} locale={locale} /></aside>
    <div class="chapter-main">
      <div class="breadcrumb" data-pagefind-ignore>
        <a href={localizeHref('/books/', locale)}>{t.books.backToShelf}</a> / <a href={localizeHref(`/books/${bookSlug}/`, locale)}>{book.title[locale]}</a> / {ch.title[locale]}
      </div>
      {!standfirst && <h1 class="visually-hidden">{ch.title[locale]}</h1>}
      {readingMin && <p class="page-meta" data-pagefind-ignore>{readingMin} {t.blog.readingTime}</p>}
      <article set:html={body} />
      {referencedIn.length > 0 && (
        <aside class="related-posts" data-pagefind-ignore>
          <h2>{t.books.referencedIn}</h2>
          <ul>{referencedIn.map(c => <li><a href={href(c.slug)}>{navLabel(c)}</a></li>)}</ul>
        </aside>
      )}
      <nav class="page-nav" data-pagefind-ignore>
        {prev
          ? <a class="page-nav-btn" href={href(prev.slug)}><div class="dir">{t.prev}</div><div class="title">{navLabel(prev)}</div></a>
          : <a class="page-nav-btn" href={localizeHref(`/books/${bookSlug}/`, locale)}><div class="dir">{t.prev}</div><div class="title">{t.books.contents}</div></a>}
        {next
          ? <a class="page-nav-btn next" href={href(next.slug)}><div class="dir">{t.next}</div><div class="title">{navLabel(next)}</div></a>
          : <span class="page-nav-btn" aria-hidden="true" style="visibility:hidden"></span>}
      </nav>
    </div>
    <PageTOC locale={locale} />
  </div>
</BaseLayout>
