{
  "name": "agentic-ai-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "og:build": "node --experimental-strip-types scripts/build-og.mjs",
    "build": "npm run og:build && astro build",
    "build:search": "astro build && pagefind --site dist",
    "search:index": "pagefind --site dist",
    "preview": "astro preview",
    "extract": "node scripts/extract-chapters.mjs",
    "verify": "npm run build && node --experimental-strip-types scripts/verify-chapters.mjs && node scripts/check-internal-links.mjs && node scripts/verify-og.mjs",
    "test": "node --test --experimental-strip-types 'scripts/__tests__/*.mjs'",
    "test:search": "node --test --experimental-strip-types scripts/__tests__/search-index.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.0",
    "@astrojs/sitemap": "^3.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^4.16.0",
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2",
    "playwright": "^1.60.0",
    "satori": "^0.26.0",
    "typescript": "^5.9.3"
  }
}
