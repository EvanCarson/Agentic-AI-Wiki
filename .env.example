# Copy to .env and fill in. .env is git-ignored; .env.example is not.
# Never put a real value in this file.
#
# This repo is public and auto-deploys from main, so a committed secret is a
# published secret. If one is ever committed, rotate it before removing it —
# the removal commit does not un-publish it.

# Vercel API access token. Used to read project and deployment state.
# Create at https://vercel.com/account/tokens; rotate there if exposed.
VERCEL_TOKEN=
